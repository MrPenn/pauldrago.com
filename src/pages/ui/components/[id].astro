---
import Styleguide from '../../../layouts/Styleguide.astro';
import Story from '../../../components/ui/Story.astro';
import { COMPONENTS, LEVELS, STATUSES, STACK_DEMO, COLS_DEMO, UNITS_DEMO, partsOf, usedIn } from '../../../styleguide/components.ts';
import { RULES } from '../../../styleguide/lint.ts';
import { inline } from '../../../styleguide/build.ts';
import { must } from '../../../data/must.ts';
import type { Component } from '../../../styleguide/components.ts';

export function getStaticPaths() {
  return COMPONENTS.map((c, i) => ({ params: { id: c.id }, props: { c, prev: COMPONENTS[i - 1], next: COMPONENTS[i + 1] } }));
}

const { c, prev, next } = Astro.props;
const level = must(LEVELS.find((l) => l.id === c.level), `level ${c.level}`);
const status = must(STATUSES.find((s) => s.id === c.status), `status ${c.status}`);
const rules = c.lint.map((id) => must(RULES.find((r) => r.id === id), `lint rule ${id}`));
// Where it sits in the kit: the smaller parts it is built from, and the larger ones built from it.
const parts = partsOf(c);
const users = usedIn(c.id);
const levelName = (x: Component) => must(LEVELS.find((l) => l.id === x.level), `level ${x.level}`).name.replace(/s$/, '').toLowerCase();
const DEMOS = { stack: STACK_DEMO, cols: COLS_DEMO, units: UNITS_DEMO };
// The controls start from the story built from the same demo data.
const LIVE = { stack: 'one-bar', cols: 'wait', units: 'twenty' };
const WHAT = { stack: 'bar', cols: 'columns', units: 'stat' };
const HINT = {
  stack: 'Each segment takes its own step, and the line to clear comes after the last one. The scale is the longest bar or line times 1.12.',
  cols: 'The event column lands after the rest. The scale top is the highest gridline; leave it blank to use the largest value.',
  units: 'Twenty or twenty-five units read at a glance. A hundred draw as two rows of fifty.',
};
const kind = c.controls;
const build = kind ? { demo: DEMOS[kind], story: must(c.stories.find((s) => s.id === LIVE[kind]), `story ${LIVE[kind]}`), what: WHAT[kind], hint: HINT[kind] } : null;
---
<Styleguide title={c.name} description={c.summary} path={`/ui/components/${c.id}`}>
  <p class="ui-crumb"><a class="link" href="/ui">Styleguide</a> <span aria-hidden="true">/</span> {level.name}</p>
  <h1 class="display-title ui-title">{c.name}</h1>
  <p class="ui-meta">
    <span class={`label ui-chip ui-chip--${c.status}`} title={status.about}>{status.name}</span>
    {c.classes.length > 0 && <span class="ui-classes">{c.classes.map((cls) => <code>.{cls}</code>)}</span>}
  </p>
  <p class="ui-lede">{c.summary}</p>
  {(parts.length > 0 || users.length > 0) && (
    <dl class="ui-parts">
      {parts.length > 0 && <div><dt>Built from</dt><dd>{parts.map((x) => <a class="link" href={`/ui/components/${x.id}`}>{x.name} <span>{levelName(x)}</span></a>)}</dd></div>}
      {users.length > 0 && <div><dt>Used in</dt><dd>{users.map((x) => <a class="link" href={`/ui/components/${x.id}`}>{x.name} <span>{levelName(x)}</span></a>)}</dd></div>}
    </dl>
  )}
  {c.status === 'template' && <p class="ui-callout">{status.about}</p>}
  {c.status === 'signature' && <p class="ui-callout">{status.about} The linter warns when it finds one too close to another article that uses it.</p>}

  <div class="ui-stories">
    {c.stories.map((s) => <Story component={c} story={s} heading="h2" />)}
  </div>

  {build && (
    <section class="ui-section ui-build" aria-labelledby="build-title">
      <h2 id="build-title" class="ui-h2">Build one</h2>
      <p class="ui-p">Type the values and the {build.what} and its HTML update together, ready to paste into an article. {build.hint} Press Replay to see it build.</p>
      <div class="ui-controls" data-controls={c.controls}>
        <script type="application/json" set:html={JSON.stringify(build.demo)}></script>
        <p class="ui-p ui-controls__fallback">The controls need JavaScript. The snippet below is the example above.</p>
      </div>
      <Story component={c} story={build.story} live />
    </section>
  )}

  <section class="ui-section ui-usage">
    <div>
      <h2 class="ui-h2">Use it for</h2>
      <ul class="ui-list">{c.use.map((u) => <li set:html={inline(u)} />)}</ul>
    </div>
    <div>
      <h2 class="ui-h2">Leave it out</h2>
      <ul class="ui-list ui-list--avoid">{c.avoid.map((u) => <li set:html={inline(u)} />)}</ul>
    </div>
  </section>

  <section class="ui-section">
    <h2 class="ui-h2">Rules</h2>
    <ol class="ui-list ui-list--numbered">{c.rules.map((r) => <li set:html={inline(r)} />)}</ol>
  </section>

  <section class="ui-section">
    <h2 class="ui-h2">Accessibility</h2>
    <ul class="ui-list">{c.a11y.map((r) => <li set:html={inline(r)} />)}</ul>
  </section>

  {rules.length > 0 && (
    <section class="ui-section">
      <h2 class="ui-h2">Checked by the linter</h2>
      <ul class="ui-rules">{rules.map((r) => <li><a href={`/ui/lint#${r.id}`}><code>{r.id}</code></a> <span>{r.title}</span></li>)}</ul>
    </section>
  )}

  <nav class="ui-pager" aria-label="Components">
    {prev ? <a class="ui-pager__link" href={`/ui/components/${prev.id}`}><span class="label">Previous</span>{prev.name}</a> : <span></span>}
    {next && <a class="ui-pager__link ui-pager__link--next" href={`/ui/components/${next.id}`}><span class="label">Next</span>{next.name}</a>}
  </nav>
</Styleguide>
