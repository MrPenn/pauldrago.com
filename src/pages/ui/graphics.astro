---
import { readFileSync } from 'node:fs';
import UiTable from '../../components/ui/UiTable.astro';
import { join } from 'node:path';
import Styleguide from '../../layouts/Styleguide.astro';
import { REFERENCE } from '../../styleguide/components.mjs';
import { imageSize } from '../../styleguide/lint.mjs';
import { highlight } from '../../styleguide/build.mjs';

// The gallery is read from the reference article's markup, so it always shows what the article uses.
const root = process.cwd();
const md = readFileSync(join(root, 'src/content/articles', `${REFERENCE.slug}.md`), 'utf8');
const shape = (w, h) => {
  const r = w / h;
  return r > 1.3 ? 'Full width' : r < 0.85 ? 'Tall' : 'Spot';
};
const art = [...md.matchAll(/<picture>\s*<source srcset="([^"]+)"[^>]*>\s*<img src="([^"]+)" width="(\d+)" height="(\d+)"[^>]*alt="([^"]*)"/g)].map((m) => {
  const [, dark, light, w, h, alt] = m;
  const d = imageSize(join(root, 'public', dark));
  return { dark, light, w: Number(w), h: Number(h), alt, darkSize: d, kind: shape(Number(w), Number(h)) };
});

const DARK_PROMPT = `Flat editorial spot illustration for a financial magazine, deadpan.
One ordinary object in an absurd situation that makes this point: [the section's point].
Navy #0A192F background. Off-white #F4F0EA line and fills. One brass #E0A938 accent on the one object the scene is about.
Hard-edged geometric shapes, thin uniform outlines. No gradients, shading, texture or shadows.
No people, no logos, no text unless the joke needs a single word or number.
Aspect ratio [16:9 for full width, 5:8 for tall, 1:1 for spot].`;
const LIGHT_PROMPT = `Rebuild this exact image in a light palette. Same composition, same objects, same positions, same aspect ratio: [the ratio above].
Flat #F1F2F4 background. Navy #0A192F line and fills. One terracotta #D9552B accent on the same object. #FFFFFF highlights, slate #4B5568 mid-tones.
Nothing gold, brass, yellow or black. Keep the margins calm and generous.`;

const LIGHT = [['#F1F2F4', 'Ground'], ['#0A192F', 'Line and fills'], ['#D9552B', 'The one accent'], ['#FFFFFF', 'Highlights'], ['#4B5568', 'Mid-tones']];
const DARK = [['#0A192F', 'Ground'], ['#F4F0EA', 'Line and fills'], ['#E0A938', 'The one accent']];

const CHOOSE = [
  ['One share of a whole the section turns on', 'Unit stat', 'unit-stat'],
  ['A count out of 100 the piece opens on, or comes back to', 'Unit grid', 'unit-grid'],
  ['The parts of a total, and a cost it has to clear', 'Stacked bar', 'stacked-bar'],
  ['Value building over time against one event', 'Rising columns', 'rising-columns'],
  ['A number the text builds one input at a time', 'Pinned sequence', 'pinned-sequence'],
  ['The reader\'s own numbers in the article\'s model', 'Calculator', 'calculator'],
  ['One number from a primary record: a fine, a ruling, a filing', 'Record', 'record'],
  ['What was live on a given day, for a record that changed over time', 'As-of slider', 'as-of'],
  ['Many owners behind one experience', 'Org fold', 'org-fold'],
  ['Three or more attributes per row, scanned across', 'Table', 'table'],
];
---
<Styleguide title="Graphics" description="Illustrations and data graphics for articles on pauldrago.com: the brief, the palettes, how they are made, and which figure to use." path="/ui/graphics">
  <h1 class="display-title ui-title">Graphics</h1>
  <p class="ui-lede">Two kinds of graphics carry an article. Illustrations make one idea stick; data graphics show the number. Both use the page's palette, and both move once, as they arrive.</p>

  <section class="ui-section" id="illustrations">
    <h2 class="ui-h2">Illustrations</h2>
    <ul class="ui-list">
      <li>Each one is a single deadpan object gag: an ordinary object in an absurd situation that states the section's point. A bank in a hoodie; one overcoat on twelve pairs of legs; twelve green gauges above an open exit door.</li>
      <li>Flat editorial drawing: hard-edged shapes, thin uniform outlines, no gradients, shading, texture or shadows.</li>
      <li>No people and no logos. Text only when the joke needs it, such as a price on a jar or a nameplate on a door.</li>
      <li>The accent colour marks the one thing the scene is about. Everything else is line and fill.</li>
      <li>Three to six per article, at the turns in the argument. The alt text describes the scene in a sentence or two and does not explain the joke.</li>
    </ul>

    <h3 class="ui-h3">Palettes</h3>
    <p class="ui-p">The illustrations have their own accents, a little brighter than the interface's, drawn for a light and a dark version of every image.</p>
    <div class="ui-palettes">
      <div>
        <p class="ui-palettes__name"><strong>Light version</strong></p>
        <ul class="ui-chips">{LIGHT.map(([hex, role]) => <li><span style={`background:${hex}`}></span><b>{hex}</b> {role}</li>)}</ul>
      </div>
      <div>
        <p class="ui-palettes__name"><strong>Dark version</strong></p>
        <ul class="ui-chips">{DARK.map(([hex, role]) => <li><span style={`background:${hex}`}></span><b>{hex}</b> {role}</li>)}</ul>
      </div>
    </div>

    <h3 class="ui-h3">Making one</h3>
    <ol class="ui-steps">
      <li>Draw the dark version first, in ChatGPT, with the prompt below and the section's point filled in.</li>
      <li>Ask for the light version as a rebuild of the same image with the second prompt. Name the aspect ratio in the request, or the two come back different shapes.</li>
      <li>Export the light file as PNG or WebP and the dark as WebP, 1200 pixels wide, each under 300 KB.</li>
      <li>If the two still differ in shape, crop both to one shape with the drawing lined up, and set the img width and height to the light file. The linter's image rules catch a mismatch.</li>
      <li>Write the alt text, and paste the snippet from the <a href="/ui/components/illustration">illustration component</a>.</li>
    </ol>
    <div class="ui-code">
      <div class="label ui-code__head"><span>Dark prompt</span><button type="button" class="pd-text-btn ui-code__copy" data-copy="prompt-dark">Copy</button><span class="ui-code__status" role="status"></span></div>
      <pre><code id="prompt-dark">{DARK_PROMPT}</code></pre>
    </div>
    <div class="ui-code" style="margin-top:12px">
      <div class="label ui-code__head"><span>Light rebuild prompt</span><button type="button" class="pd-text-btn ui-code__copy" data-copy="prompt-light">Copy</button><span class="ui-code__status" role="status"></span></div>
      <pre><code id="prompt-light">{LIGHT_PROMPT}</code></pre>
    </div>

    <h3 class="ui-h3">Sizes</h3>
    <UiTable caption="Sizes" headers={['Size', 'Shape', 'On the page', 'Class']}>
          <tr><td>Full width</td><td>About 16:9 or wider</td><td>The full text column</td><td><code>pd-img</code></td></tr>
          <tr><td>Tall</td><td>Portrait, about 5:8</td><td>Up to 420px wide, centred</td><td><code>pd-img is-tall</code></td></tr>
          <tr><td>Spot</td><td>About square</td><td>Up to 520px wide, centred</td><td><code>pd-img is-spot</code></td></tr>
          <tr><td>Inside a graphic</td><td>Any</td><td>Up to 380px tall, in an org fold</td><td><code>pd-one</code></td></tr>
        </UiTable>

    <h3 class="ui-h3">In the reference article</h3>
    <p class="ui-p">Every illustration in <a class="link" href={`/articles/${REFERENCE.slug}`}>{REFERENCE.title}</a>, light and dark side by side.</p>
    <div class="ui-gallery">
      {art.map((a) => (
        <figure class="ui-gallery__item">
          <div class="ui-gallery__pair">
            <span class="is-light" style="background:#F1F2F4"><img src={a.light} width={a.w} height={a.h} loading="lazy" alt="" /></span>
            <span class="is-dark" style="background:#0A192F"><img src={a.dark} width={a.darkSize?.w ?? a.w} height={a.darkSize?.h ?? a.h} loading="lazy" alt="" /></span>
          </div>
          <figcaption><strong>{a.kind}</strong>, {a.w} by {a.h}. {a.alt}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="ui-section" id="data">
    <h2 class="ui-h2">Data graphics</h2>
    <p class="ui-p">Pick the figure by what the reader needs to see.</p>
    <UiTable caption="Data graphics" headers={['The reader needs to see', 'Use']}>{CHOOSE.map(([need, name, id]) => <tr><td>{need}</td><td><a class="link" href={`/ui/components/${id}`}>{name}</a></td></tr>)}</UiTable>
    <h3 class="ui-h3">Every data graphic</h3>
    <ul class="ui-list">
      <li>An eyebrow names what it shows.</li>
      <li>Every amount is printed on the graphic: inside a segment, at the end of a bar, in a callout or in the ledger. Nothing has to be read off an axis.</li>
      <li>Ink for context, the accent for the one thing the sentence is about.</li>
      <li>It builds once, in the order the text argues, with a beat before the part to notice. Nothing loops.</li>
      <li>The caption or a footnote names who measured it, the sample and the year, and says what the figure leaves out.</li>
      <li>The finished figure ships in the HTML; the kit script only takes parts away to bring them back.</li>
      <li>The same number in the short version, the text and the graphic comes from one data mark.</li>
    </ul>
    <h3 class="ui-h3">Not used</h3>
    <ul class="ui-list ui-list--avoid">
      <li>Pie and donut charts. A unit grid or a stacked bar shows the same share with the number printed.</li>
      <li>3D, gradients, drop shadows and glows.</li>
      <li>A legend where a label can sit on the mark.</li>
      <li>Two axes on one chart, and more than three or four gridlines.</li>
      <li>Dashboards of small charts that each say little.</li>
    </ul>
  </section>
</Styleguide>
