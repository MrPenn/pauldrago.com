---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { AUTHOR } from '../../data/author';
import FrontDoorOpener from '../../components/FrontDoorOpener.astro';
import BookingLine from '../../components/BookingLine.astro';
import { curlHtml } from '../../integrations/smart-quotes.mjs';

export async function getStaticPaths() {
  // `npm run build:drafts` also builds drafts, for previewing locally; they are never listed or indexed.
  const articles = await getCollection('articles', ({ data }) => !data.draft || process.env.SHOW_DRAFTS === '1');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const iso = (d) => d.toISOString().slice(0, 10);
const long = (d) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const path = `/articles/${article.id}`;
const words = [...article.data.brief, article.body ?? ''].join(' ').replace(/\[\^\d+\]:.*$/gm, '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
// Footnotes become schema.org citations: "[^n]: **Publisher.** Title. ... [link](url)".
// Footnote text is markdown, so inline tags (component marks) are dropped and named entities decoded.
const ENTITIES = { amp: '&', quot: '"', sect: '\u00a7', times: '\u00d7', iacute: '\u00ed', auml: '\u00e4', eacute: '\u00e9' };
const clean = (s) => s.replace(/<[^>]+>/g, '').replace(/&([a-z]+);/gi, (m, n) => ENTITIES[n] ?? m);
const citations = [...(article.body ?? '').matchAll(/^\[\^\d+\]:\s*\*\*(.+?)\*\*\s*(.*)$/gm)].map(([, rawWho, rawRest]) => {
  const who = clean(rawWho);
  const rest = clean(rawRest);
  const url = rest.match(/\]\((https?:\/\/[^)\s]+)\)/)?.[1];
  // The title is the first sentence; abbreviations such as "pp." or "p." don't end it.
  const title = rest.replace(/\[[^\]]*\]\([^)]*\)/g, '').split(/(?<!\b(?:pp|p|No|Vol|vs|U\.S))\.\s+(?=[A-Z0-9])/)[0].trim();
  return {
    '@type': 'CreativeWork',
    name: title || who.replace(/\.$/, ''),
    author: { '@type': 'Organization', name: who.replace(/\.$/, '') },
    ...(url ? { url } : {}),
  };
});
const url = `https://pauldrago.com${path}`;
const imageUrl = article.data.ogImage ? `https://pauldrago.com${article.data.ogImage}` : undefined;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: article.data.title,
      description: article.data.description,
      breadcrumb: { '@id': `${url}#breadcrumb` },
      mainEntity: { '@id': `${url}#article` },
    },
    {
      '@type': 'Article',
      '@id': `${url}#article`,
      mainEntityOfPage: { '@id': `${url}#webpage` },
      isPartOf: { '@id': 'https://pauldrago.com/#website' },
      headline: article.data.title,
      description: article.data.description,
      datePublished: iso(article.data.date),
      dateModified: iso(article.data.updated ?? article.data.date),
      url,
      inLanguage: 'en-US',
      author: { '@id': AUTHOR.id },
      publisher: { '@id': 'https://pauldrago.com/#organization' },
      ...(article.data.kicker ? { articleSection: article.data.kicker } : {}),
      ...(article.data.topics.length ? { keywords: article.data.topics.join(', '), about: article.data.topics.map((name) => ({ '@type': 'Thing', name })) } : {}),
      wordCount: words,
      timeRequired: `PT${minutes}M`,
      ...(imageUrl ? { image: { '@type': 'ImageObject', url: imageUrl, width: 1200, height: 630, caption: article.data.ogImageAlt } } : {}),
      ...(citations.length ? { citation: citations } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Articles', item: 'https://pauldrago.com/articles' },
        { '@type': 'ListItem', position: 2, name: article.data.title, item: url },
      ],
    },
  ],
};
---
<Base
  title={`${article.data.title} | Paul Drago`}
  description={article.data.description}
  path={path}
  variant="articles"
  subline="Articles"
  ogType="article"
  robots={article.data.draft ? 'noindex, nofollow' : ''}
  ogImage={article.data.ogImage ? `https://pauldrago.com${article.data.ogImage}` : undefined}
  ogImageAlt={article.data.ogImageAlt}
  published={iso(article.data.date)}
  modified={iso(article.data.updated ?? article.data.date)}
  footerNote="Writing on marketing measurement, markets, and accountable growth."
  stylesheets={['/assets/personal-site.css', '/assets/article.css', ...article.data.stylesheets]}
  scripts={['/assets/article.js', ...article.data.scripts]}
  lastUpdated={iso(article.data.updated ?? article.data.date)}
  jsonld={jsonld}
>
  <main id="main">
    <article class="article">
      <div class="container">
        {article.data.opener === 'fd-grid' ? <FrontDoorOpener /> : article.data.opener && <div class="article-opener" data-opener={article.data.opener} aria-hidden="true"></div>}
        <header class="article-header">
          <p class="article-kicker"><a href="/articles">Articles</a>{article.data.kicker && <span class="article-kicker-sep" aria-hidden="true"> / </span>}{article.data.kicker && <span>{article.data.kicker}</span>}</p>
          <h1 class="display-title article-title">{article.data.title}</h1>
          <p class="article-intro">{article.data.description}</p>
          <p class="article-date"><time datetime={iso(article.data.date)}>{long(article.data.date)}</time><span class="article-meta-sep" aria-hidden="true"> / </span><span>{minutes}-minute read</span></p>
          <p class="article-byline" data-c="author-byline">By <a href="/">{AUTHOR.name}</a>, {AUTHOR.byline}</p>
        </header>
        <div class="article-body" data-notes={article.data.notes}>
          {article.data.brief.length > 0 && (
            <aside class="article-brief" aria-label="The short version" data-c="short-version">
              <p class="article-brief-label">The short version</p>
              <ol>{article.data.brief.map((item) => <li set:html={curlHtml(item)} />)}</ol>
            </aside>
          )}
          <Content />
          <BookingLine />
        </div>
        <aside class="article-author" aria-label="About the author" data-c="author-bio">
          <p class="article-author-label">About the author</p>
          <p class="article-author-bio">{AUTHOR.bio}</p>
          <p class="article-author-links">
            <a class="btn btn-small" href={AUTHOR.booking} {...AUTHOR.calAttrs}>Book a 20-minute call</a>
            <a class="article-author-link" href={AUTHOR.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a class="article-author-link" href="mailto:paul@pauldrago.com">paul@pauldrago.com</a>
          </p>
        </aside>
      </div>
    </article>
  </main>
</Base>
