---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { AUTHOR } from '../../data/author';
import FrontDoorOpener from '../../components/FrontDoorOpener.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const iso = (d) => d.toISOString().slice(0, 10);
const long = (d) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const path = `/articles/${article.id}`;
const words = (article.body ?? '').replace(/\[\^\d+\]:.*$/gm, '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: iso(article.data.date),
  dateModified: iso(article.data.updated ?? article.data.date),
  url: `https://pauldrago.com${path}`,
  author: {
    '@type': 'Person',
    '@id': AUTHOR.id,
    name: AUTHOR.name,
    url: AUTHOR.url,
    jobTitle: AUTHOR.jobTitle,
    description: AUTHOR.bio,
    sameAs: [AUTHOR.linkedin],
  },
  publisher: { '@id': AUTHOR.id },
  ...(article.data.ogImage ? { image: `https://pauldrago.com${article.data.ogImage}` } : {}),
};
---
<Base
  title={`${article.data.title} | Paul Drago`}
  description={article.data.description}
  path={path}
  variant="articles"
  subline="Articles"
  ogType="article"
  ogImage={article.data.ogImage ? `https://pauldrago.com${article.data.ogImage}` : undefined}
  ogImageAlt={article.data.ogImageAlt}
  published={iso(article.data.date)}
  modified={iso(article.data.updated ?? article.data.date)}
  footerNote="Writing on marketing measurement, markets, and accountable growth."
  stylesheets={['/assets/personal-site.css', ...article.data.stylesheets]}
  scripts={article.data.scripts}
  lastUpdated={iso(article.data.updated ?? article.data.date)}
  jsonld={jsonld}
>
  <main id="main">
    <article class="article">
      <div class="container">
        {article.data.opener === 'fd-grid' ? <FrontDoorOpener /> : article.data.opener && <div class="article-opener" data-opener={article.data.opener} aria-hidden="true"></div>}
        <header class="article-header">
          <p class="article-kicker"><a href="/articles">Articles</a>{article.data.kicker && <span class="article-kicker-sep" aria-hidden="true"> / </span>}{article.data.kicker && <span>{article.data.kicker}</span>}</p>
          <h1 class="display-title article-title">{article.data.title}</h1>
          <p class="article-intro">{article.data.description}</p>
          <p class="article-date"><time datetime={iso(article.data.date)}>{long(article.data.date)}</time><span class="article-meta-sep" aria-hidden="true"> · </span><span>{minutes}-minute read</span></p>
          <p class="article-byline">By <a href="/">{AUTHOR.name}</a>, {AUTHOR.byline}</p>
        </header>
        <div class="article-body">
          <Content />
        </div>
        <aside class="article-author" aria-label="About the author">
          <p class="article-author-label">About the author</p>
          <p class="article-author-bio">{AUTHOR.bio}</p>
          <p class="article-author-links">
            <a class="btn btn-small" href={AUTHOR.booking} {...AUTHOR.calAttrs}>Book a 20-minute call</a>
            <a class="article-author-link" href={AUTHOR.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a class="article-author-link" href="mailto:paul@pauldrago.com">paul@pauldrago.com</a>
          </p>
        </aside>
      </div>
    </article>
  </main>
</Base>
