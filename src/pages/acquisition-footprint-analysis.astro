---
import Base from '../layouts/Base.astro';
import { breadcrumb } from '../data/schema';
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://pauldrago.com/acquisition-footprint-analysis#webpage",
      "url": "https://pauldrago.com/acquisition-footprint-analysis",
      "name": "Bank Acquisition and Footprint Analysis",
      "description": "Evaluate acquisition targets through deposits, market fit, branch overlap, retention assumptions, and local-brand risk.",
      "about": {
        "@id": "https://pauldrago.com/acquisition-footprint-analysis#service"
      },
      "mainEntity": {
        "@id": "https://pauldrago.com/acquisition-footprint-analysis#service"
      },
      "breadcrumb": {
        "@id": "https://pauldrago.com/acquisition-footprint-analysis#breadcrumb"
      },
      "author": {
        "@id": "https://pauldrago.com/#paul-drago"
      }
    },
    {
      "@type": "Service",
      "@id": "https://pauldrago.com/acquisition-footprint-analysis#service",
      "url": "https://pauldrago.com/acquisition-footprint-analysis",
      "name": "Acquisition and Footprint Analysis",
      "serviceType": "Bank acquisition footprint analysis",
      "description": "Deposit, market, footprint-overlap, retention, and local-brand analysis for evaluating bank acquisition targets.",
      "provider": {
        "@id": "https://pauldrago.com/#organization"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Banks and credit unions"
      },
      "areaServed": "United States"
    },
    breadcrumb('https://pauldrago.com/acquisition-footprint-analysis#breadcrumb', [
      ['Services', 'https://pauldrago.com/financial-services'],
      ['Acquisition and Footprint Analysis', 'https://pauldrago.com/acquisition-footprint-analysis'],
    ])
  ]
};
import OtherDecisions from '../components/OtherDecisions.astro';
import SignalGrid from '../components/SignalGrid.astro';
import Deliverables from '../components/Deliverables.astro';
import Offer from '../components/Offer.astro';
import ServiceClosingBand from '../components/ServiceClosingBand.astro';
---
<Base
  title="Bank Acquisition and Footprint Analysis | Paul Drago"
  description="Evaluate bank acquisition targets through deposits, market fit, branch overlap, retention assumptions, and local-brand risk."
  path="/acquisition-footprint-analysis"
  footerNote="Acquisition and footprint analysis for banks and credit unions."
  ogType="website"
  ogImage="https://pauldrago.com/assets/evidence-table-social.jpg"
  stylesheets={['/assets/services.css', '/assets/service-detail.css']}
  lastUpdated="2026-09-23"
  jsonld={jsonld}
>
<main id="main">
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <p class="eyebrow">For bank leadership and transaction teams</p>
          <h1 class="display-title hero__title">Test what an acquisition target <span class="accent">actually adds</span>.</h1>
          <p class="subhead">Separate attractive deposits and market whitespace from branch overlap, customer attrition, concentration, and local-brand risk.</p>
        </div>
        <figure class="model" aria-labelledby="footprint-model-title">
          <p class="kicker">What you receive</p>
          <p class="display-title model__title" id="footprint-model-title">What the deal adds, and what it duplicates</p>
          <div class="model__stage" aria-hidden="true">
            <span class="model__circle model__circle--current"></span>
            <span class="model__circle model__circle--target"></span>
          </div>
          <ul class="model__legend">
            <li><span class="model__key model__key--current" aria-hidden="true"></span><span><strong>Current footprint.</strong> Your branches and deposits today.</span></li>
            <li><span class="model__key model__key--target" aria-hidden="true"></span><span><strong>Target only.</strong> The markets and deposits the deal actually adds.</span></li>
            <li><span class="model__key model__key--overlap" aria-hidden="true"></span><span><strong>Overlap.</strong> Duplicated branches, consolidation, and customer attrition risk.</span></li>
          </ul>
          <figcaption class="model__note">Illustration, not client data. The analysis sizes each area from FDIC Summary of Deposits, NCUA, and Census data.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <hr class="section-divider">
  <SignalGrid
    heading="The footprint map is where the case starts."
    intro="A target can fill geographic whitespace and still create weak economics, concentrated overlap, or avoidable customer loss. Each part of the case needs its own source and assumption."
    signals={[
      { title: 'Deposit quality', copy: 'Branch-level deposits, market position, product mix, growth, and customer concentration show what sits behind the headline total.' },
      { title: 'Footprint fit', copy: 'Branch overlap, market adjacency, customer geography, and competitor presence show where the target extends the franchise and where it duplicates it.' },
      { title: 'Retention risk', copy: 'Brand changes, branch consolidation, product migration, and relationship ownership become explicit assumptions instead of a single haircut.' },
    ]}
  />

  <Deliverables
    heading="A target brief with every assumption named."
    items={[
      { title: 'Deposit profile', copy: 'Reported deposits, growth, market share, branch concentration, and the parts of the base that matter strategically.' },
      { title: 'Footprint analysis', copy: 'Overlap, whitespace, adjacency, branch density, and customer geography displayed in one market frame.' },
      { title: 'Retention register', copy: 'Documented assumptions for deposit attrition, branch consolidation, brand transition, and relationship continuity.' },
      { title: 'Executive brief', copy: 'The strategic case, the risks that can change it, and the diligence questions that need an answer before the next decision.' },
    ]}
  />

  <Offer
    title="Acquisition and Footprint Analysis"
    copy="The scope follows the target, markets, and diligence stage. The work can begin with public information and become more specific as internal branch, customer, and product data are available."
    producesCopy="You receive the market case, overlap analysis, and retention assumptions in one brief."
    inputsTitle="Typical inputs"
    inputs={[
      'The target list and strategic thesis',
      'FDIC or NCUA institution, branch, and market data',
      'Current and target branch footprints',
      'Customer geography and product information when available',
      'Retention, consolidation, and brand assumptions',
    ]}
  />

  <OtherDecisions current="/acquisition-footprint-analysis" />
  <ServiceClosingBand
    title="Bring the target and the question the board needs answered."
    copy="We will separate public facts from institution assumptions and identify the diligence that could change the recommendation."
    prepList={[
      'The target or target list',
      'The current footprint view',
      'The strategic question under review',
    ]}
  />

  <section class="sources" aria-labelledby="sources-heading"><div class="container"><h2 class="kicker sources__label" id="sources-heading">Primary public-data sources</h2><ol class="sources__list"><li><a href="https://banks.data.fdic.gov/bankfind-suite/SOD">FDIC Summary of Deposits</a> for branch deposits, deposit market share, and market-presence reporting.</li><li><a href="https://www.fdic.gov/resources/data-tools">FDIC Data Tools</a> for institution history, mergers, branch structure, and financial reports.</li><li><a href="https://ncua.gov/analysis/credit-union-corporate-call-report-data">NCUA Call Report data</a> for federally insured credit-union financial and institutional information.</li><li><a href="https://www.census.gov/programs-surveys/acs/data/data-via-api.html">U.S. Census Bureau American Community Survey</a> for demographic, household, housing, and economic context.</li></ol></div></section>
</main>
</Base>
