---
// Sample deliverable for Branch and Market Expansion Analysis: the five-year plan as it would go to a
// board. Every figure is computed from src/data/dfw-markets.json (scripts/build-dfw-markets.py), the
// pipeline from src/data/dfw-signals.json, and the plan from src/data/branch-plan.ts.
import Base from '../../layouts/Base.astro';
import MarketTable from '../../components/MarketTable.astro';
import CountyMaps from '../../components/CountyMaps.astro';
import data from '../../data/dfw-markets.json';
import signals from '../../data/dfw-signals.json';
import mapData from '../../data/dfw-map.json';
import { INSTITUTION, PRESETS, scoreMarkets } from '../../data/market-scoring';
import { TAGS, PLAN, REVIEW_SITES, PICKING_TAGS, YEARS, HORIZON, LAUNCH_MARKETING, BANK, tagsFor, planModel, paceScenarios, runSites, returns } from '../../data/branch-plan';

const SITE = 'https://pauldrago.com';
const path = '/branch-market-expansion-analysis/sample-plan';
const meta = {
  title: 'Sample Five-Year Branch Plan: Kaufman and Ellis Counties | Paul Drago',
  description: 'A sample deliverable from a branch and market expansion analysis: a five-year plan for a hypothetical Dallas community bank, built on public FDIC, Census, and HMDA data.',
  path,
  variant: 'product',
  subline: 'Branch and Market Expansion Analysis',
  footerNote: 'Sample deliverable. The bank is hypothetical; the data is public.',
  stylesheets: ['/assets/service-detail.css', '/assets/sample-plan.css'],
  lastUpdated: '2026-09-23',
};
const jsonld = {
  '@graph': [
    {
      '@type': 'WebPage', '@id': `${SITE}${path}#webpage`, url: `${SITE}${path}`,
      name: 'Sample five-year branch plan: Kaufman and Ellis counties', description: meta.description,
      mainEntity: { '@id': `${SITE}${path}#report` },
      breadcrumb: { '@id': `${SITE}${path}#breadcrumb` },
      author: { '@id': `${SITE}/#paul-drago` },
    },
    {
      '@type': 'Report', '@id': `${SITE}${path}#report`, name: 'Five-year branch plan: Kaufman and Ellis counties (sample)',
      description: meta.description, datePublished: '2026-09-23', inLanguage: 'en-US',
      author: { '@id': `${SITE}/#paul-drago` }, publisher: { '@id': `${SITE}/#organization` },
      about: { '@id': `${SITE}/branch-market-expansion-analysis#service` },
    },
    {
      '@type': 'BreadcrumbList', '@id': `${SITE}${path}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Services', item: `${SITE}/financial-services` },
        { '@type': 'ListItem', position: 2, name: 'Branch and Market Expansion Analysis', item: `${SITE}/branch-market-expansion-analysis` },
        { '@type': 'ListItem', position: 3, name: 'Sample five-year plan', item: `${SITE}${path}` },
      ],
    },
  ],
};

const markets = data.markets;
const by = Object.fromEntries(markets.map((m) => [m.county, m]));
const { Collin, Ellis, Kaufman } = by;
const fullCase = scoreMarkets(markets, PRESETS.full.weights);
const mapView = scoreMarkets(markets, PRESETS.map.weights);
// Kaufman first, as the plan runs.
const towns = [...data.towns].sort((a, b) => (a.county === b.county ? 0 : a.county === 'Kaufman' ? -1 : 1));
const town = (name) => towns.find((t) => t.town === name);
const ramp = data.ramp;
const model = planModel(ramp);
const planTowns = PLAN.map((b) => ({ ...b, ...town(b.site), tags: tagsFor(town(b.site)) }));
const tagLabel = Object.fromEntries(TAGS.map((t) => [t.key, t.label]));
const incumbent = Kaufman.leaders[0];
const shortName = (name) => name.replace(/, National Association$/, '').replace(/ Bank$/, '');
const collinLeaders = Collin.leaders.map((l) => shortName(l.bank));
const collinLeaderShare = Collin.leaders.reduce((s, l) => s + l.share, 0);

const pct = (n) => `${Math.round(n)}%`;
const num = (n) => Math.round(n).toLocaleString('en-US');
const money = (b) => `$${b.toFixed(1)}B`;
const depUSD = (m) => (m >= 1000 ? `$${(m / 1000).toFixed(1)}B` : `$${m}M`);
const mUSD = (n) => `$${(Math.abs(n) / 1000).toFixed(1)}M`;
// Negatives in parentheses, the accounting convention.
const tUSD = (n) => { const v = `$${(Math.abs(n) / 1000).toFixed(Math.abs(n) < 1000 ? 2 : 1)}M`; return n < 0 ? `(${v})` : v; };
const costUSD = (n) => (n >= 1000 ? `$${n / 1000}M` : `$${n}K`);
const age = (n) => ramp.byAge.find((a) => a.age === n);
const failing = (a) => a.belowBreakevenShare + (100 - a.stillOpenShare);
const gate = model.path('median')[2];
const industryBreakeven = Math.round(ramp.branchCost[1] / ramp.nimIndustry / 10);
const industryPayback = Math.round((ramp.buildOut * 1000 + ramp.paybackYears * ramp.branchCost[1]) / ramp.paybackYears / ramp.nimIndustry / 10);
const firstTwoBuild = PLAN.filter((b) => b.opens <= 2).length * ramp.buildOut;
const paces = paceScenarios(ramp);
const [planPace, fasterPace] = paces;
const bottomQuarter10 = (sites) => runSites(ramp, sites, HORIZON, 'p25').cumulative[HORIZON.length - 1];
const launchTotal = LAUNCH_MARKETING.reduce((a, b) => a + b, 0);
const planReturn = returns(planPace.run);
const earningsEffect = model.operating.map((o, i) => o + model.marketing[i]);
const worstEarnings = Math.min(...earningsEffect);
const worstEarningsYear = YEARS[earningsEffect.indexOf(worstEarnings)];
const share = (v, base) => `${((Math.abs(v) / base) * 100).toFixed(1)}%`;
const exitAge = 4;
const [first, second, third] = PLAN.map((b) => town(b.site));
// Distance between the first and third sites, from the map's projected town points.
const kaufmanMap = mapData.counties.find((c) => c.county === 'Kaufman');
const pt = (name) => kaufmanMap.towns.find((t) => t.town === name);
const siteGap = Math.round(Math.hypot(pt(first.town).x - pt(third.town).x, pt(first.town).y - pt(third.town).y) / kaufmanMap.milePx);

const fairRows = [
  { label: 'People living in low- or moderate-income tracts', show: (f) => pct(f.lmiPopulationShare) },
  { label: 'People living in majority-minority tracts', show: (f) => pct(f.minorityPopulationShare) },
  { label: 'Low- or moderate-income tracts with no bank branch', show: (f) => `${f.lmiTractsWithoutBranch} of ${f.lmiTracts}` },
  { label: 'Home-purchase loans in those tracts', show: (f) => pct(f.purchaseLoansInLmiShare) },
  { label: "Those tracts' share of owner-occupied homes", show: (f) => pct(f.ownerHomesInLmiShare) },
];
const planCounties = ['Kaufman', 'Ellis'];

// Ramp chart: ages 0-5 across, $0-120M up.
const W = 640, H = 260, L = 76, R = 36, T = 12, B = 32, YMAX = 120;
const x = (a) => L + (a / 5) * (W - L - R);
const y = (v) => T + (1 - v / YMAX) * (H - T - B);
const line = (key) => model.path(key).map((v, a) => `${a ? 'L' : 'M'}${x(a).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const band = `${line('p75')} ${model.path('p25').map((v, a) => [a, v]).reverse().map(([a, v]) => `L${x(a).toFixed(1)},${y(v).toFixed(1)}`).join(' ')} Z`;

const link = (href, text) => ({ href, text });
const SOURCES = {
  fed: link('https://www.federalreserve.gov/econres/notes/feds-notes/size-and-survival-of-entrants-to-retail-banking-20230901.html', 'Federal Reserve, 2023'),
  ab: link('https://www.americanbanker.com/news/the-more-things-change-bank-ceos-on-why-theyre-adding-branches', 'American Banker, April 2026'),
  be: link('https://www.bankingexchange.com/recent-articles/item/2079-workbook-time-to-close-underperforming-branches', 'Banking Exchange'),
  bam: link('https://www.bitsaboutmoney.com/archive/branch-banking/', 'Bits About Money'),
  qbp: link('https://www.fdic.gov/quarterly-banking-profile/quarterly-banking-profile-2q-2026', 'FDIC, second quarter 2026'),
};
---
<Base {...meta} jsonld={jsonld}>
<main id="main" class="sample-plan">
  <div class="container">
    <p class="sample-banner">Sample deliverable. The bank is hypothetical; every market figure comes from public data and can be checked. <a href="/branch-market-expansion-analysis">About this analysis</a></p>

    <div class="report-cover">
      <p class="report-status"><strong>For decision</strong><span>Confidential, board use only</span><span>Board meeting, October 2026</span><span>Owner: Chief Banking Officer</span></p>
      <h1 class="display-title report-title">Five-year branch plan: Kaufman and Ellis counties</h1>
      <p class="report-meta">Prepared by Paul Drago, Glass Vase, LLC, for the board of {INSTITUTION.description}. Reviewed by the CFO, chief credit officer, CRA and fair-lending officer, and chief risk officer. Data as of {signals.asOf}. Supports a business decision; not legal advice or a CRA determination.</p>
    </div>

    <section class="report-brief" aria-label="Two-page brief">
      <section class="brief-block" id="recommendation" aria-labelledby="ask-h">
        <h2 class="brief-h2" id="ask-h">The board is asked to approve</h2>
        <p class="report-lede">{mUSD(firstTwoBuild * 1000)} to open branches in {first.town} (year 1) and {second.town} (year 2), with ${num(2 * launchTotal)}K of launch marketing, and {third.town} in principle for year 3 if {first.town} holds ${gate}M in deposits at the end of year 2.</p>
        <p class="report-p brief-why">These are the towns where deposits and business are both growing and community banks still win deposits, which is the strategic plan's case for growing outside Dallas County. The network covers its running cost from year {model.firstPositiveYear} and earns back the build-out in year {planPace.paybackYear}. In Kaufman, the branches reach low- or moderate-income and majority-minority neighborhoods; in Ellis, Midlothian doesn't, so the plan commits lending there.</p>
        <dl class="report-figures">
          <div><dt>Capital</dt><dd><span class="report-figure">{mUSD(model.totalBuildOut * 1000)}</span><span class="report-figure-note">{mUSD(firstTwoBuild * 1000)} now, {mUSD((model.totalBuildOut - firstTwoBuild) * 1000)} for {third.town} at the gate; {share(model.totalBuildOut * 1000, BANK.tier1)} of Tier 1 capital</span></dd></div>
          <div><dt>Earnings</dt><dd><span class="report-figure">{tUSD(worstEarnings)}</span><span class="report-figure-note">pre-tax in year {worstEarningsYear}, the worst year ({share(worstEarnings, BANK.pretaxIncome)} of pre-tax income); positive from year {model.firstPositiveYear}</span></dd></div>
          <div><dt>Return</dt><dd><span class="report-figure">{Math.round(planReturn.irr * 100)}% IRR</span><span class="report-figure-note">ten years plus continuing year-10 earnings; NPV {mUSD(planReturn.npv)} at a {Math.round(BANK.hurdle * 100)}% hurdle</span></dd></div>
          <div><dt>Payback</dt><dd><span class="report-figure">Year {planPace.paybackYear}</span><span class="report-figure-note">cumulative, including build-out and marketing</span></dd></div>
        </dl>
        <div class="market-table-wrap">
          <table class="market-table plan-network brief-econ">
            <caption class="sr-only">Network contribution by year under the plan</caption>
            <thead><tr><th scope="col">The plan</th>{YEARS.map((n) => <th scope="col">Year {n}</th>)}</tr></thead>
            <tbody>
              <tr><th scope="row">Branches, operating</th>{model.operating.map((t) => <td class:list={[{ 'is-negative': t < 0 }]}>{tUSD(t)}</td>)}</tr>
              <tr><th scope="row">Launch marketing</th>{model.marketing.map((t) => <td class:list={[{ 'is-negative': t < 0 }]}>{t ? tUSD(t) : ''}</td>)}</tr>
              <tr><th scope="row">Build-out</th>{model.buildOut.map((t) => <td class:list={[{ 'is-negative': t < 0 }]}>{t ? tUSD(t) : ''}</td>)}</tr>
              <tr class="plan-total"><th scope="row">Cumulative</th>{model.cumulative.map((t) => <td class:list={[{ 'is-negative': t < 0 }]}>{tUSD(t)}</td>)}</tr>
            </tbody>
          </table>
        </div>
        <p class="brief-note">Pre-tax, on the median Dallas-Fort Worth ramp at a {ramp.nim}% margin, up to {costUSD(ramp.branchCost[1])} a year to run each branch; fee income and overhead left out. The build-out is paid from cash; the branches add about ${num(planPace.deposits10)}M of deposits by year 10. Tier 1 capital (${num(BANK.tier1 / 1000)}M) and pre-tax income (${num(BANK.pretaxIncome / 1000)}M) are illustrative (<a href="#economics">appendix E</a>).</p>
      </section>

      <section class="brief-block" aria-labelledby="options-h">
        <h2 class="brief-h2" id="options-h">Options considered</h2>
        <div class="market-table-wrap">
          <table class="market-table brief-options">
            <caption class="sr-only">Options considered</caption>
            <tbody>
              <tr class="is-plan"><th scope="row">The plan, recommended</th><td>{planPace.by10} branches; peak need {mUSD(-planPace.peak)} (build-out plus early losses); pays back in year {planPace.paybackYear}; {mUSD(planPace.year10)} a year by year 10.</td></tr>
              <tr><th scope="row">Faster</th><td>{fasterPace.by10} branches by year 3; peak need {mUSD(-fasterPace.peak)}; same payback year; {mUSD(fasterPace.year10)} a year by year 10. Not recommended: {mUSD(planPace.peak - fasterPace.peak)} more at risk while {pct(failing(age(5)))} of new branches fail.</td></tr>
              <tr><th scope="row">Loan production office first</th><td>Lenders in the market for less than a branch costs, but an office like this can't take deposits, and deposits are the case for going. Worth weighing for Terrell at the review.</td></tr>
              <tr><th scope="row">Acquisition</th><td>Several small banks already have branches in these counties. Buying one brings deposits on day one, at a premium; not modelled here, and it needs its own analysis.</td></tr>
              <tr><th scope="row">Do nothing</th><td>No capital at risk, while deposits in the two counties grew {pct(Kaufman.depositGrowthPct)} and {pct(Ellis.depositGrowthPct)} over five years without the bank.</td></tr>
            </tbody>
          </table>
        </div>
      </section>


      <section class="brief-block" aria-labelledby="reg-h">
        <h2 class="brief-h2" id="reg-h">Regulatory path</h2>
        <p class="report-p brief-p">Each branch needs a regulator's approval. Since February 27, 2026, the FDIC expedites branch applications from well-capitalized banks rated 1 or 2 with a Satisfactory CRA rating, without public notice; the OCC can waive notice for banks rated Satisfactory. File for {first.town} once the site is under contract.</p>
      </section>

      <div class="brief-page-two">
        <CountyMaps />

        <section class="brief-block" aria-labelledby="gates-h">
          <h2 class="brief-h2" id="gates-h">Gates, reporting and exit</h2>
          <ul class="report-risks brief-risks">
            <li><strong>Gate.</strong> {third.town} is released only if {first.town} holds ${gate}M in deposits at the end of year 2.</li>
            <li><strong>Reporting.</strong> Each branch against its planned ramp every June. {REVIEW_SITES.join(' and ')} are decided at the year 5 review, on actual results.</li>
            <li><strong>Exit.</strong> A branch below ${ramp.breakeven}M, where it covers its running cost, at the end of year {exitAge} comes back to the board with a consolidate-or-continue recommendation.</li>
          </ul>
        </section>

        <section class="brief-block" aria-labelledby="risks-brief-h">
          <h2 class="brief-h2" id="risks-brief-h">Risks and how they are handled</h2>
          <ul class="report-risks brief-risks">
            <li><strong>Slow ramps.</strong> {pct(failing(age(5)))} of new branches in the metro were closed or not covering running cost at year 5. If all three ramp like the bottom quarter, the plan never pays back ({mUSD(-bottomQuarter10(planPace.sites))} lost by year 10). Handled by the gate and the exit rule.</li>
            <li><strong>The incumbent.</strong> {incumbent.bank} holds {pct(incumbent.share)} of Kaufman's deposits{third.largestBank === incumbent.bank ? ` and ${pct(third.largestBankShare)} of ${third.town}'s` : ''}. Handled by hiring lenders who know its customers before {third.town} opens.</li>
            <li><strong>{first.town} and {third.town} overlap.</strong> They are about {siteGap} miles apart. Handled by siting {third.town} southwest of town, toward the growth.</li>
            <li><strong>Fair lending in Ellis.</strong> No one within five miles of {second.town} lives in a low- or moderate-income tract. Handled by the lending commitment around Waxahachie and Ennis from year 2.</li>
            <li><strong>The CRA rule.</strong> The plan assumes the OCC and FDIC proposal is final. If it isn't, or the bank is supervised by the Federal Reserve, a $2 billion bank stays a large bank and Waxahachie moves ahead of {third.town}.</li>
          </ul>
        </section>



        <div class="brief-resolution">
          <p class="brief-h2">Draft resolution</p>
          <p><span class="resolved">Resolved,</span> that the board approves branches in {first.town} and {second.town} with capital spending of up to {mUSD(firstTwoBuild * 1000)} and launch marketing of up to ${num(2 * launchTotal)}K; approves a branch in {third.town} in principle, to be released by the board if the {first.town} branch holds ${gate}M in deposits at the end of its second year; and authorizes management to file the required applications.</p>
          <p class="brief-sign"><span>Secretary</span><span>Date</span></p>
        </div>

        <nav class="brief-appendix" aria-label="Appendix">
          <p><strong>Appendix:</strong> <a href="#markets">A. Why Kaufman and Ellis</a>, <a href="#sites">B. Why these towns</a>, <a href="#pipeline">C. What's coming</a>, <a href="#cra">D. CRA and fair lending</a>, <a href="#economics">E. Economics</a>, <a href="#risks">F. Other risks and questions</a>, <a href="#methods">G. Data and definitions</a>.</p>
        </nav>
      </div>
    </section>


    <div class="appendix-divider" aria-hidden="true"><span>Appendix</span></div>

    <section class="report-section report-appendix" id="markets" aria-labelledby="markets-h">
      <h2 class="report-h2" id="markets-h"><span>A</span> Why Kaufman and Ellis</h2>
      <p class="report-p">Weighted on deposit size, income, and deposit growth, {mapView[0].county} ranks first. Weighted on where the market is going and who wins its deposits, the order is {fullCase.map((r) => `${r.county} (${r.score})`).join(', ')}. Collin is the bigger prize, but it is the largest banks' market: {collinLeaders.slice(0, -1).join(', ')} and {collinLeaders.at(-1)} hold {pct(collinLeaderShare)} of it, and community banks captured {money(Collin.communityGrowth)} of its {money(Collin.depositGrowth)} deposit growth since 2021. In Kaufman, community banks hold {pct(Kaufman.communityShare)} of deposits and a typical community-bank branch holds ${Kaufman.medianCommunityBranch}M. In Ellis, {pct(Ellis.communityShare)}.</p>
      <MarketTable />
    </section>

    <section class="report-section report-appendix" id="sites" aria-labelledby="sites-h">
      <h2 class="report-h2" id="sites-h"><span>B</span> Why these towns</h2>
      <p class="report-p">Each candidate town is tagged for what a branch there would do. Deposits and Business pick the sites; CRA is the check the network has to pass (appendix D).</p>
      <ul class="report-rules">
        {TAGS.map((t) => <li><span class:list={['tag', { 'tag-check': !PICKING_TAGS.includes(t.key) }]}>{t.label}</span> {t.rule}.</li>)}
      </ul>
        <div class="appendix-plan">
          <h3 class="report-h3" id="plan">The sequence</h3>
          <div class="market-table-wrap">
            <table class="market-table report-plan-table">
              <caption class="sr-only">The branch sequence</caption>
              <thead><tr><th scope="col">Year</th><th scope="col">Site</th><th scope="col">Tags</th><th scope="col">Why here</th></tr></thead>
              <tbody>
                <tr><td>1</td><th scope="row">{first.town}</th><td>{tagsFor(first).map((t) => <span class:list={['tag', { 'tag-check': !PICKING_TAGS.includes(t) }]}>{tagLabel[t]}</span>)}</td><td>Deposits +{pct(first.depositGrowthPct)} since 2021, jobs +{pct(first.jobGrowthPct)} since 2019. A hospital opens on US-80 in 2027.</td></tr>
                <tr><td>2</td><th scope="row">{second.town}</th><td>{tagsFor(second).map((t) => <span class:list={['tag', { 'tag-check': !PICKING_TAGS.includes(t) }]}>{tagLabel[t]}</span>)}</td><td>Deposits +{pct(second.depositGrowthPct)}, jobs +{pct(second.jobGrowthPct)}. Medline opens in 2027; the highest home-purchase tract on either map.</td></tr>
                <tr><td>3</td><th scope="row">{third.town}</th><td>{tagsFor(third).map((t) => <span class:list={['tag', { 'tag-check': !PICKING_TAGS.includes(t) }]}>{tagLabel[t]}</span>)}</td><td>Deposits +{pct(third.depositGrowthPct)}, the fastest studied, all in {third.branches === 1 ? 'one branch' : `${third.branches} branches`} of the county's largest bank. Gated on {first.town}.</td></tr>
                <tr><td>5</td><th scope="row">Review</th><td></td><td>{REVIEW_SITES.join(' and ')}, decided on actual results.</td></tr>
              </tbody>
            </table>
          </div>
        </div>

      <h3 class="report-h3">The candidate towns</h3>
      <div class="market-table-wrap">
        <table class="market-table report-towns">
          <caption class="sr-only">Candidate towns in Kaufman and Ellis counties</caption>
          <thead><tr><th scope="col">Town</th><th scope="col">Deposits</th><th scope="col">Growth</th><th scope="col">Per branch</th><th scope="col">Job growth</th><th scope="col">Low/mod-income residents</th><th scope="col">Tags</th></tr></thead>
          <tbody>
            {towns.map((t) => (
              <tr class:list={[{ 'is-plan': PLAN.some((b) => b.site === t.town) }]}>
                <th scope="row">{t.town}<span class="report-county">{t.county}{PLAN.some((b) => b.site === t.town) && ', in plan'}</span></th>
                <td>{depUSD(t.deposits)}</td>
                <td>{t.depositGrowthPct >= 0 ? '+' : ''}{pct(t.depositGrowthPct)}</td>
                <td>${t.depositsPerBranch}M</td>
                <td>{t.jobGrowthPct >= 0 ? '+' : ''}{pct(t.jobGrowthPct)}</td>
                <td>{pct(t.lmiPopulationShare)}</td>
                <td class="report-tags">{tagsFor(t).map((k) => <span class:list={['tag', { 'tag-check': !PICKING_TAGS.includes(k) }]}>{tagLabel[k]}</span>)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="market-table-note">{data.asOf.towns}. Low/mod-income residents: share living in tracts below 80% of the metro median family income.</p>
      </div>
      <div class="market-findings market-findings-two">
        <div class="market-finding">
          <h3>{first.town} goes first: faster growth, fewer large banks</h3>
          <p>{first.town}'s jobs grew {pct(first.jobGrowthPct)} to {second.town}'s {pct(second.jobGrowthPct)}, and community banks hold {pct(first.communityShare)} of its deposits against {pct(second.communityShare)} in {second.town}, where the largest banks are already established.</p>
        </div>
        <div class="market-finding">
          <h3>{third.town}: the fastest deposit growth, and one incumbent branch to take on</h3>
          <p>With no other town tagged for both, the third site goes to the fastest deposit growth: {third.town}'s grew {pct(third.depositGrowthPct)} since 2021, all of it held by {third.branches === 1 ? 'one branch' : `${third.branches} branches`} of {third.largestBank}. Waxahachie grew {pct(town('Waxahachie').depositGrowthPct)} with {town('Waxahachie').branches} branches competing; Terrell has Amazon's payroll coming but slower deposits. Both wait for the year 5 review.</p>
        </div>
      </div>
    </section>

    <section class="report-section report-appendix" id="pipeline" aria-labelledby="pipeline-h">
      <h2 class="report-h2" id="pipeline-h"><span>C</span> What's coming</h2>
      <p class="report-p">Announced and under-construction projects, checked against primary sources, as of {signals.asOf}. Each is marked for what it brings a bank.</p>
      <div class="pipe-columns report-pipe">
        {planCounties.map((county) => {
          const c = signals.counties[county];
          return (
            <section class="pipe-county" aria-labelledby={`signals-${county}`}>
              <h3 id={`signals-${county}`}>{county}</h3>
              <ul class="pipe-list">
                {c.signals.map((sig) => (
                  <li class="pipe">
                    <p class="pipe-meta"><span class="pipe-brings">{sig.brings}</span><span>{sig.status}, {sig.when}</span></p>
                    <p class="pipe-title">{sig.title}</p>
                    <p class="pipe-detail">{sig.detail} <a href={sig.url} target="_blank" rel="noopener noreferrer">{sig.source}</a></p>
                  </li>
                ))}
              </ul>
              <p class="pipe-watch"><strong>Watch:</strong> {c.watch}</p>
            </section>
          );
        })}
      </div>
    </section>

    <section class="report-section report-appendix" id="cra" aria-labelledby="cra-h">
      <h2 class="report-h2" id="cra-h"><span>D</span> CRA and fair lending</h2>
      <p class="report-p">This plan assumes the rule the OCC and FDIC proposed on July 31, 2026 is final (<a href="https://www.fdic.gov/news/press-releases/2026/agencies-issue-joint-proposal-amending-community-reinvestment-act-rules" target="_blank" rel="noopener noreferrer">FDIC</a>; <a href="https://www.federalregister.gov/documents/2026/08/12/2026-16454/community-reinvestment-act-regulations" target="_blank" rel="noopener noreferrer">Federal Register, August 12, 2026</a>). It moves the large-bank line from $1.649 billion (<a href="https://www.federalreserve.gov/newsevents/pressreleases/bcreg20251230a.htm" target="_blank" rel="noopener noreferrer">2026 thresholds</a>) to $10 billion, so a $2 billion bank supervised by either agency is an intermediate bank: a tailored lending test and a community development test, with no separate test of where its branches sit. Assessment areas are still drawn around branches, so each county joins the bank's assessment area with its first branch there, and fair-lending review of branch and lending patterns applies at any size. The Federal Reserve did not join the proposal; a state member bank stays under today's large-bank rules until it acts. Income levels below follow the FFIEC bands: low is below 50% of the metro median family income (${num(Kaufman.fairAccess.metroMedianFamilyIncome)}), moderate is 50% to 80%.</p>
      <div class="market-table-wrap">
        <table class="market-table">
          <caption class="sr-only">CRA and fair-access measures for the three counties</caption>
          <thead><tr><th scope="col"><span class="sr-only">Measure</span></th>{markets.map((m) => <th scope="col">{m.county}</th>)}</tr></thead>
          <tbody>
            {fairRows.map((r) => <tr><th scope="row">{r.label}</th>{markets.map((m) => <td>{r.show(m.fairAccess)}</td>)}</tr>)}
          </tbody>
        </table>
        <p class="market-table-note">{data.asOf.fairAccess}. Home-purchase loans are owner-occupied originations by all lenders in {data.asOf.fairAccess.match(/HMDA (\d{4})/)?.[1]}.</p>
      </div>
      <h3 class="report-h3">Kaufman meets the CRA test; Ellis needs a lending commitment</h3>
      <p class="report-p">In Kaufman, {pct(first.minorityPopulationShare)} of the people within five miles of {first.town} live in majority-minority tracts, and {pct(third.lmiPopulationShare)} of those near {third.town} live in low- or moderate-income tracts. Home-purchase lending in the county's low- or moderate-income tracts ({pct(Kaufman.fairAccess.purchaseLoansInLmiShare)} of loans) runs below those tracts' share of owner-occupied homes ({pct(Kaufman.fairAccess.ownerHomesInLmiShare)}), a gap the bank's lending there can close.</p>
      <p class="report-p">In Ellis, no one within five miles of {second.town} lives in a low- or moderate-income tract, and {pct(second.minorityPopulationShare)} live in majority-minority tracts. The plan answers that with lending: a mortgage and small-business lending commitment in the low- or moderate-income tracts around Waxahachie ({pct(town('Waxahachie').lmiPopulationShare)} of nearby residents) and Ennis ({pct(town('Ennis').lmiPopulationShare)}) from year 2, with Waxahachie at the year 5 review.</p>
    </section>

    <section class="report-section report-appendix" id="economics" aria-labelledby="economics-h">
      <h2 class="report-h2" id="economics-h"><span>E</span> Economics</h2>
      <h3 class="report-h3">Fewer than half of new branches hold ${ramp.target}M at year 5</h3>
      <div class="plan-ramp">
        <figure class="plan-chart">
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="ramp-chart-title">
            <title id="ramp-chart-title">Deposits in new community-bank branches by year since opening, against the ${ramp.breakeven}M operating break-even and the ${ramp.target}M payback level: the median reaches ${age(3).median}M in year 3 and ${age(5).median}M in year 5.</title>
            {[0, 40, 80, 120].map((v) => <g class="plan-grid"><line x1={L} x2={W - R} y1={y(v)} y2={y(v)} /><text x={L - 8} y={y(v)} dy={v ? '0.35em' : '-0.1em'}>{v ? `$${v}M` : '$0'}</text></g>)}
            {[0, 1, 2, 3, 4, 5].map((a) => <text class="plan-axis" x={x(a)} y={H - 10}>{a === 0 ? 'Open' : `Year ${a}`}</text>)}
            <path class="plan-band" d={band} />
            <line class="plan-target" x1={L} x2={W - R} y1={y(ramp.target)} y2={y(ramp.target)} />
            <line class="plan-breakeven" x1={L} x2={W - R} y1={y(ramp.breakeven)} y2={y(ramp.breakeven)} />
            <text class="plan-line-label" x={L + 6} y={y(ramp.target)} dy="-0.45em">${ramp.target}M payback level</text>
            <text class="plan-line-label plan-line-label-end" x={W - R - 6} y={y(ramp.breakeven)} dy="1.15em">${ramp.breakeven}M operating break-even</text>
            <path class="plan-median" d={line('median')} />
          </svg>
          <figcaption>Line: the median branch. Shaded: the middle half. {ramp.branches} community-bank branches opened new in the metro from {ramp.opened[0]} to {ramp.opened[1]}, tracked every June; {ramp.relocationsExcluded} relocations excluded because they opened with deposits. {data.asOf.ramp}.</figcaption>
        </figure>
        <div class="market-table-wrap">
          <table class="market-table plan-outcomes">
            <caption class="sr-only">Outcomes for new community-bank branches at years 1, 3, and 5</caption>
            <thead><tr><th scope="col">Share of branches</th><th scope="col">Year 1</th><th scope="col">Year 3</th><th scope="col">Year 5</th></tr></thead>
            <tbody>
              <tr><th scope="row">Closed</th>{[1, 3, 5].map((n) => <td>{pct(100 - age(n).stillOpenShare)}</td>)}</tr>
              <tr><th scope="row">Open, below operating break-even</th>{[1, 3, 5].map((n) => <td>{pct(age(n).belowBreakevenShare)}</td>)}</tr>
              <tr><th scope="row">Above operating break-even, below ${ramp.target}M</th>{[1, 3, 5].map((n) => <td>{pct(age(n).stillOpenShare - age(n).belowBreakevenShare - age(n).atTargetShare)}</td>)}</tr>
              <tr><th scope="row">At the ${ramp.target}M payback level or more</th>{[1, 3, 5].map((n) => <td>{pct(age(n).atTargetShare)}</td>)}</tr>
            </tbody>
          </table>
          <p class="market-table-note">A new branch has to earn back its build-out, about ${ramp.buildOut}M, which Bancography expects to recover in {ramp.paybackYears} years (<a href={SOURCES.ab.href} target="_blank" rel="noopener noreferrer">{SOURCES.ab.text}</a>), and its running cost, up to {costUSD(ramp.branchCost[1])} a year (<a href={SOURCES.be.href} target="_blank" rel="noopener noreferrer">{SOURCES.be.text}</a>; <a href={SOURCES.bam.href} target="_blank" rel="noopener noreferrer">{SOURCES.bam.text}</a>). At the community-bank net interest margin of {ramp.nim}% (<a href={SOURCES.qbp.href} target="_blank" rel="noopener noreferrer">{SOURCES.qbp.text}</a>), covering the running cost takes ${ramp.breakeven}M in deposits: operating break-even. Earning back ${ramp.buildOut}M plus {ramp.paybackYears} years of running cost within {ramp.paybackYears} years takes an average of ${ramp.payback}M: call it ${ramp.target}M, the payback level. That is also what the median new branch holds 15 years after opening (<a href={SOURCES.fed.href} target="_blank" rel="noopener noreferrer">{SOURCES.fed.text}</a>).</p>
        </div>
      </div>

        <h3 class="report-h3">Going faster pays back in the same year and puts {mUSD(planPace.peak - fasterPace.peak)} more at risk</h3>
        <div class="market-table-wrap">
          <table class="market-table brief-pace">
            <caption class="sr-only">Two paces compared over ten years</caption>
            <thead><tr><th scope="col">Over ten years</th><th scope="col">Branches</th><th scope="col">Peak capital</th><th scope="col">Pays back</th><th scope="col">Year 10 earnings</th><th scope="col">Deposits, year 10</th></tr></thead>
            <tbody>
              {paces.map((p) => (
                <tr class:list={[{ 'is-plan': p.label === 'The plan' }]}>
                  <th scope="row">{p.label}</th>
                  <td>{p.by10}{p.by5 !== p.by10 ? ` (${p.by5} by year 5)` : ` by year ${Math.max(...p.sites.map((x) => x.opens))}`}</td>
                  <td>{mUSD(-p.peak)}</td>
                  <td>{p.paybackYear ? `Year ${p.paybackYear}` : 'After year 10'}</td>
                  <td>{mUSD(p.year10)} a year</td>
                  <td>${num(p.deposits10)}M</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="market-table-note">Pre-tax. Median Dallas-Fort Worth ramp at a {ramp.nim}% margin, up to {costUSD(ramp.branchCost[1])} a year to run each branch, deposits held at year-5 levels after that; fee income and overhead left out. If every branch ramps like the bottom quarter, neither pace pays back ({mUSD(-bottomQuarter10(planPace.sites))} lost by year 10 on the plan, {mUSD(-bottomQuarter10(fasterPace.sites))} on the faster one); the {third.town} gate and the year 5 review limit that exposure.</p>

      <h3 class="report-h3">A branch turns positive in its third year and earns about {mUSD(model.expected[0].byYear[4].contribution)} a year by its fifth</h3>
      <div class="market-table-wrap">
        <table class="market-table plan-network">
          <caption class="sr-only">Operating contribution by branch and year under the plan</caption>
          <thead><tr><th scope="col">Operating contribution</th>{YEARS.map((n) => <th scope="col">Year {n}</th>)}</tr></thead>
          <tbody>
            {model.expected.map((b) => (
              <tr><th scope="row">{b.site}</th>{b.byYear.map((yr) => <td class:list={[{ 'is-negative': yr && yr.contribution < 0 }]}>{yr ? tUSD(yr.contribution) : ''}</td>)}</tr>
            ))}
            <tr class="plan-total"><th scope="row">Branches, operating</th>{model.operating.map((t) => <td class:list={[{ 'is-negative': t < 0 }]}>{tUSD(t)}</td>)}</tr>
            <tr><th scope="row">Operating, if every branch ramps like the bottom quarter</th>{model.downside.map((t) => <td class:list={[{ 'is-negative': t < 0 }]}>{tUSD(t)}</td>)}</tr>
          </tbody>
        </table>
        <p class="market-table-note">Launch marketing is ${LAUNCH_MARKETING[0]}K in a branch's first year and ${LAUNCH_MARKETING[1]}K in its second. Published first-year budgets for a new branch run $50K to $150K (<a href="https://www.chatterbuzzmedia.com/blog/credit-union-new-branch-opening-playbook/" target="_blank" rel="noopener noreferrer">Chatter Buzz Media, 2026</a>), and a branch in a new market needs 18 to 24 months of marketing (<a href="http://bankingjournal.aba.com/2026/08/bank-marketings-essential-role-in-successful-branch-expansion/" target="_blank" rel="noopener noreferrer">ABA Banking Journal, August 2026</a>); the second-year figure is our assumption.</p>
      </div>

      <div class="pace-block">
      <h3 class="report-h3">The faster pace is {mUSD(planPace.run.cumulative[1] - fasterPace.run.cumulative[1])} deeper in year 2 and {mUSD(fasterPace.run.cumulative[9] - planPace.run.cumulative[9])} ahead by year 10</h3>
      <p class="market-table-note pace-note">Pre-tax. The plan: {planPace.sites.map((x) => `${x.site} (year ${x.opens})`).join(', ')}. Faster: {fasterPace.sites.map((x) => `${x.site} (year ${x.opens})`).join(', ')}.</p>
      <div class="market-table-wrap">
        <table class="market-table plan-network pace-table">
          <caption class="sr-only">Cumulative cash by year for two paces</caption>
          <thead><tr><th scope="col">Cumulative, $M</th>{HORIZON.map((n) => <th scope="col">Year {n}</th>)}</tr></thead>
          <tbody>
            {paces.map((p) => <tr><th scope="row">{p.label}</th>{p.run.cumulative.map((t) => <td class:list={[{ 'is-negative': t < 0 }]}>{t < 0 ? `(${(Math.abs(t) / 1000).toFixed(1)})` : (t / 1000).toFixed(1)}</td>)}</tr>)}
          </tbody>
        </table>
        
      </div>
      </div>
    </section>

    <section class="report-section report-appendix" id="risks" aria-labelledby="risks-h">
      <h2 class="report-h2" id="risks-h"><span>F</span> Other risks and questions before the vote</h2>
      <ul class="report-risks">
        <li><strong>The pipeline slips.</strong> The Forney hospital (fall 2027) and Medline's Midlothian distribution center (second quarter of 2027) anchor the first two sites. A delay of a year moves each ramp by a year.</li>
        <li><strong>Margins narrow.</strong> At the all-bank margin of {ramp.nimIndustry}% instead of {ramp.nim}%, operating break-even moves to ${industryBreakeven}M and the payback level to ${industryPayback}M.</li>
      </ul>
      <h3 class="report-h3" id="questions">Questions before the vote</h3>
      <p class="report-p">The data can't answer these. The bank's lenders, branch managers, directors, and the local economic development offices can, and the answers belong in the board packet next to the numbers.</p>
      <ol class="local-questions">
        <li><strong>Is {incumbent.bank}'s hold on Kaufman loyalty or habit?</strong> Who at our bank knows its customers?</li>
        <li><strong>Forney's growth is households.</strong> Do they bank near home or near work in Dallas, and does that call for a full branch or a smaller one with lenders?</li>
        <li><strong>Medline and the Midlothian industrial parks bring payroll from 2027.</strong> Which employers need treasury and payroll services, and who banks them today?</li>
        <li><strong>{third.town}'s growth is along the Dallas County line.</strong> Do those households bank in {third.town}, in Forney, or back in Dallas?</li>
        <li><strong>How many of our customers already live or work in Kaufman and Ellis?</strong> Our customer file answers this in an afternoon.</li>
        <li><strong>Two new counties join our assessment area.</strong> Under the final rule, what does compliance need to see, and does our charter change the answer?</li>
      </ol>
    </section>

    <section class="report-section report-appendix" id="methods" aria-labelledby="methods-h">
      <h2 class="report-h2" id="methods-h"><span>G</span> Data and definitions</h2>
      <ol class="report-sources">
        <li><a href="https://banks.data.fdic.gov/bankfind-suite/SOD">FDIC Summary of Deposits</a>: branch deposits, 2008 to 2026.</li>
        <li><a href="https://www.census.gov/programs-surveys/popest.html">Census population estimates</a> and <a href="https://www.census.gov/programs-surveys/acs">American Community Survey</a>: population, households, income.</li>
        <li><a href="https://www.census.gov/programs-surveys/cbp.html">Census ZIP Code Business Patterns</a>: jobs by town, 2019 and 2023.</li>
        <li><a href="https://ffiec.cfpb.gov/data-browser/">HMDA</a>: tract income and minority data, and home-purchase lending, 2025.</li>
        <li><a href="https://www.fdic.gov/board/federal-register-notice-branch-final-rule.pdf">FDIC branch application rule</a>, effective February 27, 2026.</li>
      </ol>
      <p class="report-p report-small">{data.notes.join(' ')} Towns are measured by branch city for deposits, ZIP code for jobs, and census tracts within five miles of the town center for income. Tag thresholds are judgments, stated so they can be argued with. The bank and its capital, income, and hurdle rate are illustrative; this plan supports a business decision; it is not legal advice, a fair-lending analysis, or a CRA compliance determination.</p>
    </section>

