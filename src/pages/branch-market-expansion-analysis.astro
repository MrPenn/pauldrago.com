---
import Base from '../layouts/Base.astro';
const meta = {
  "title": "Bank Branch and Market Expansion Analysis | Paul Drago",
  "description": "Compare bank and credit union markets using deposit share, growth, customer geography, branch economics, CRA context, and fair-lending considerations.",
  "path": "/branch-market-expansion-analysis",
  "variant": "product",
  "subline": "Branch and Market Expansion Analysis",
  "footerNote": "Branch and market expansion analysis for banks and credit unions.",
  "ogType": "website",
  "ogImage": "https://pauldrago.com/assets/evidence-table-social.jpg",
  "ogImageAlt": "",
  "robots": "",
  "stylesheets": [
    "/assets/service-detail.css"
  ],
  "scripts": [],
  "lastUpdated": "2026-09-23"
};
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://pauldrago.com/branch-market-expansion-analysis#webpage",
      "url": "https://pauldrago.com/branch-market-expansion-analysis",
      "name": "Bank Branch and Market Expansion Analysis",
      "description": "Compare markets using deposit share, growth, customer geography, branch economics, CRA context, and fair-lending considerations.",
      "about": {
        "@id": "https://pauldrago.com/branch-market-expansion-analysis#service"
      },
      "mainEntity": {
        "@id": "https://pauldrago.com/branch-market-expansion-analysis#service"
      },
      "breadcrumb": {
        "@id": "https://pauldrago.com/branch-market-expansion-analysis#breadcrumb"
      },
      "author": {
        "@id": "https://pauldrago.com/#paul-drago"
      }
    },
    {
      "@type": "Service",
      "@id": "https://pauldrago.com/branch-market-expansion-analysis#service",
      "url": "https://pauldrago.com/branch-market-expansion-analysis",
      "name": "Branch and Market Expansion Analysis",
      "serviceType": "Bank branch and market analysis",
      "description": "A five-year expansion plan: a documented market scorecard, competitor and deposit-share view, CRA and fair-access context, a branch growth model measured against local new-branch performance, and a reusable assumptions model.",
      "provider": {
        "@id": "https://pauldrago.com/#organization"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Banks and credit unions"
      },
      "areaServed": "United States"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://pauldrago.com/branch-market-expansion-analysis#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Services",
          "item": "https://pauldrago.com/financial-services"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Branch and Market Expansion Analysis",
          "item": "https://pauldrago.com/branch-market-expansion-analysis"
        }
      ]
    }
  ]
};
import OtherDecisions from '../components/OtherDecisions.astro';
import MarketExample from '../components/MarketExample.astro';
import marketData from '../data/dfw-markets.json';
import { PRESETS, scoreMarkets } from '../data/market-scoring';
// Hero hook: what the deposit map says, what the branch economics say, and the one fact behind it.
const mapPick = scoreMarkets(marketData.markets, PRESETS.map.weights)[0].county;
const casePick = scoreMarkets(marketData.markets, PRESETS.full.weights)[0].county;
const heroMarkets = Object.fromEntries(marketData.markets.map((m) => [m.county, m]));
const branchBars = [...marketData.markets].sort((a, b) => b.medianCommunityBranch - a.medianCommunityBranch);
const maxBranch = branchBars[0].medianCommunityBranch;
---
<Base {...meta} jsonld={jsonld}>
<main id="main">
  <section class="hero">
    <div class="container">
      <div class="hero__grid hero__grid--model">
        <div>
          <p class="eyebrow">For bank and credit union leadership teams</p>
          <h1 class="display-title hero__title">Compare markets before committing to a <span class="accent">branch plan</span>.</h1>
          <p class="subhead">The biggest deposit market is rarely the best place to grow. Test each one before the board commits.</p>
        </div>
        <figure class="model model--flip" aria-labelledby="branch-model-title">
          <p class="model__label">A worked example on real data</p>
          <p class="model__title" id="branch-model-title">Where should a Dallas bank grow over the next five years?</p>
          <div class="model__answers">
            <div class="model__answer">
              <span class="model__answer-label">The deposit map says</span>
              <span class="model__answer-county">{mapPick} County</span>
              <span class="model__answer-why">${heroMarkets[mapPick].deposits.toFixed(1)}B in deposits, the biggest market</span>
            </div>
            <div class="model__answer model__answer--case">
              <span class="model__answer-label">The branch economics say</span>
              <span class="model__answer-county">{casePick} County</span>
              <span class="model__answer-why">{Math.round(heroMarkets[casePick].communityShare)}% of deposits at community banks</span>
            </div>
          </div>
          <p class="model__evidence-title">Deposits in a typical community-bank branch</p>
          <dl class="model__bars">
            {branchBars.map((m) => (
              <div class:list={['model__bar', { 'model__bar--case': m.county === casePick }]}>
                <dt>{m.county}</dt>
                <dd class="model__bar-track" aria-hidden="true"><span style={`width: ${Math.round((m.medianCommunityBranch / maxBranch) * 100)}%`}></span></dd>
                <dd class="model__bar-value">${m.medianCommunityBranch}M</dd>
              </div>
            ))}
          </dl>
          <figcaption class="model__note">FDIC Summary of Deposits, June 2026. <a href="#worked-example">See how the answer flips</a>.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <hr class="section-divider">
  <section class="problem-band">
    <div class="container">
      <h2 class="section-title-plain">A branch recommendation is only as defensible as its assumptions.</h2>
      <p class="section-intro">A clean map can hide a weak case. The analysis keeps public market facts, customer evidence, institution-specific economics, and regulatory and fair-access considerations separate long enough to test each one.</p>
      <div class="signal-grid">
        <div class="signal"><h3 class="signal__title">Public market data</h3><p class="signal__copy">Branch deposits, market share, household and business growth, competitor presence, and concentration establish the market context.</p></div>
        <div class="signal"><h3 class="signal__title">Customer geography</h3><p class="signal__copy">Existing households, businesses, digital acquisition, service patterns, and access gaps show whether the institution already has a reason to be there.</p></div>
        <div class="signal"><h3 class="signal__title">Institution economics</h3><p class="signal__copy">Target balances, ramp assumptions, staffing, cannibalization, and operating constraints turn market attractiveness into a branch decision.</p></div>
      </div>
    </div>
  </section>

  <MarketExample />

  <section class="compliance-section">
    <div class="container">
      <h2 class="section-title-plain">CRA, fair banking, and fair lending belong in the market case.</h2>
      <p class="section-intro">The work identifies where branch geography, assessment areas, community credit needs, products, marketing, service levels, and access require institution compliance and legal review.</p>
      <p class="section-intro"><a class="section-link" href="/branch-market-expansion-analysis/sample-plan#cra">See the CRA and fair-access section of the sample plan</a></p>
    </div>
  </section>

  <section class="build-section">
    <div class="container">
      <h2 class="section-title-plain">An expansion plan with the assumptions attached.</h2>
      <div class="deliverables">
        <div class="deliverable"><div class="deliverable__num">01</div><h3 class="deliverable__title">Market and assessment-area definition</h3><p class="deliverable__copy">A documented view of the counties, ZIP codes, trade areas, time periods, current CRA assessment areas, and other relevant service geographies.</p></div>
        <div class="deliverable"><div class="deliverable__num">02</div><h3 class="deliverable__title">Weighted scorecard</h3><p class="deliverable__copy">A ranking model with visible weights, thresholds, source fields, sensitivity tests, and CRA and fair-access flags that should affect diligence.</p></div>
        <div class="deliverable"><div class="deliverable__num">03</div><h3 class="deliverable__title">Competitive and access view</h3><p class="deliverable__copy">Deposit share, branch density, competitor movement, customer proximity, service access, and market whitespace displayed in the same frame.</p></div>
        <div class="deliverable"><div class="deliverable__num">04</div><h3 class="deliverable__title">Five-year expansion plan</h3><p class="deliverable__copy">The sequence of markets and sites, the ramp each branch is measured against, what the network carries while they ramp, and the cost of CRA commitments named up front.</p></div>
      </div>
    </div>
  </section>

  <section class="offer">
    <div class="container">
      <div class="offer__grid">
        <div>
          <h2 class="offer__title">Branch and Market Expansion Analysis</h2>
          <p class="offer__copy">The scope follows the number of markets, the branch question, and the customer data available. The finished model stays with the institution and can be reused when the market list changes.</p>
          <div class="offer__produces"><p class="offer__produces-copy">You receive a five-year expansion plan for the board and the analysis behind it.</p></div>
        </div>
        <div>
          <div class="offer__inputs-title">Typical inputs</div>
          <div class="offer__inputs">
            <div class="offer__input"><span>01</span><span>The current market list and branch thesis</span></div>
            <div class="offer__input"><span>02</span><span>FDIC or NCUA institution and market data</span></div>
            <div class="offer__input"><span>03</span><span>Census household, income, and business context</span></div>
            <div class="offer__input"><span>04</span><span>Customer geography and existing network performance</span></div>
            <div class="offer__input"><span>05</span><span>The latest CRA performance evaluation and current assessment areas</span></div>
            <div class="offer__input"><span>06</span><span>Fair-lending monitoring, branch policy, and known access concerns</span></div>
            <div class="offer__input"><span>07</span><span>Branch economics and leadership assumptions</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <OtherDecisions current="/branch-market-expansion-analysis" />
  <section class="closing-band">
    <div class="container">
      <div class="closing-band__grid">
        <div><h2 class="display-title closing-band__title">Bring the market list and the current branch case.</h2><p class="closing-band__copy">We will identify which facts support the recommendation, which assumptions need testing, and which questions belong with compliance or counsel.</p></div>
        <aside class="call-prep"><div class="call-prep__title">Bring to the call</div><p class="call-prep__copy">The markets under consideration and the latest CRA performance evaluation are enough to start.</p><a class="btn" href="https://cal.com/pauldrago/20-min-intro-call" data-cal-link="pauldrago/20-min-intro-call" data-cal-namespace="20-min-intro-call" data-cal-config='&#123;"layout":"month_view","useSlotsViewOnSmallScreen":"true","theme":"auto"&#125;'>Book a call</a></aside>
      </div>
    </div>
  </section>

  <section class="sources" aria-labelledby="sources-heading">
    <div class="container"><h2 class="sources__label" id="sources-heading">Primary public-data and regulatory sources</h2><ol class="sources__list"><li><a href="https://banks.data.fdic.gov/bankfind-suite/SOD">FDIC Summary of Deposits</a> for branch deposits, market share, and branch-office data.</li><li><a href="https://ncua.gov/analysis/credit-union-corporate-call-report-data">NCUA Call Report data</a> for federally insured credit-union financial and institutional information.</li><li><a href="https://www.census.gov/programs-surveys/acs/data/data-via-api.html">U.S. Census Bureau American Community Survey</a> for demographic, household, housing, and economic context.</li><li><a href="https://www.ffiec.gov/data/cra/interagency-qa">FFIEC CRA resources</a> for current interagency CRA guidance and assessment-area considerations.</li><li><a href="https://www.consumerfinance.gov/compliance/compliance-resources/other-applicable-requirements/equal-credit-opportunity-act/">CFPB Equal Credit Opportunity Act resources</a> for fair-lending requirements under ECOA and Regulation B.</li><li><a href="https://www.fdic.gov/consumer-compliance-examination-manual/iv-3-fdic-fair-lending-scope-and-conclusions-memorandum">FDIC fair-lending examination resources</a> for geographic, branch-service, product, and market-area risk considerations.</li><li><a href="https://www.fdic.gov/bank-examinations/establishing-relocating-or-closing-office">FDIC branch-office resources</a> for establishment, relocation, and closing requirements.</li></ol><p class="sources__note">This work supports business decision-making and institution review. It does not replace legal advice, a fair-lending analysis, or a CRA compliance determination.</p></div>
  </section>
</main>
</Base>
