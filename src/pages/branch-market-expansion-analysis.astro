---
import Base from '../layouts/Base.astro';
import { breadcrumb } from '../data/schema';
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://pauldrago.com/branch-market-expansion-analysis#webpage",
      "url": "https://pauldrago.com/branch-market-expansion-analysis",
      "name": "Bank Branch and Market Expansion Analysis",
      "description": "Compare markets using deposit share, growth, customer geography, branch economics, CRA context, and fair-lending considerations.",
      "about": {
        "@id": "https://pauldrago.com/branch-market-expansion-analysis#service"
      },
      "mainEntity": {
        "@id": "https://pauldrago.com/branch-market-expansion-analysis#service"
      },
      "breadcrumb": {
        "@id": "https://pauldrago.com/branch-market-expansion-analysis#breadcrumb"
      },
      "author": {
        "@id": "https://pauldrago.com/#paul-drago"
      }
    },
    {
      "@type": "Service",
      "@id": "https://pauldrago.com/branch-market-expansion-analysis#service",
      "url": "https://pauldrago.com/branch-market-expansion-analysis",
      "name": "Branch and Market Expansion Analysis",
      "serviceType": "Bank branch and market analysis",
      "description": "A five-year expansion plan: a documented market scorecard, competitor and deposit-share view, CRA and fair-access context, a branch growth model measured against local new-branch performance, and a reusable assumptions model.",
      "provider": {
        "@id": "https://pauldrago.com/#organization"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Banks and credit unions"
      },
      "areaServed": "United States"
    },
    breadcrumb('https://pauldrago.com/branch-market-expansion-analysis#breadcrumb', [
      ['Services', 'https://pauldrago.com/financial-services'],
      ['Branch and Market Expansion Analysis', 'https://pauldrago.com/branch-market-expansion-analysis'],
    ])
  ]
};
import OtherDecisions from '../components/OtherDecisions.astro';
import SignalGrid from '../components/SignalGrid.astro';
import Deliverables from '../components/Deliverables.astro';
import Offer from '../components/Offer.astro';
import ServiceClosingBand from '../components/ServiceClosingBand.astro';
import MarketExample from '../components/MarketExample.astro';
import marketData from '../data/dfw-markets.json';
import { PRESETS, scoreMarkets } from '../data/market-scoring';
// Hero hook: what the deposit map says, what the branch economics say, and the one fact behind it.
const mapPick = scoreMarkets(marketData.markets, PRESETS.map.weights)[0].county;
const casePick = scoreMarkets(marketData.markets, PRESETS.full.weights)[0].county;
const heroMarkets = Object.fromEntries(marketData.markets.map((m) => [m.county, m]));
const branchBars = [...marketData.markets].sort((a, b) => b.medianCommunityBranch - a.medianCommunityBranch);
const maxBranch = branchBars[0].medianCommunityBranch;
---
<Base
  title="Bank Branch and Market Expansion Analysis | Paul Drago"
  description="Compare bank and credit union markets using deposit share, growth, customer geography, branch economics, CRA context, and fair-lending considerations."
  path="/branch-market-expansion-analysis"
  footerNote="Branch and market expansion analysis for banks and credit unions."
  ogType="website"
  ogImage="https://pauldrago.com/assets/evidence-table-social.jpg"
  stylesheets={['/assets/services.css', '/assets/service-detail.css']}
  lastUpdated="2026-09-23"
  jsonld={jsonld}
>
<main id="main">
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <p class="eyebrow">For bank and credit union leadership teams</p>
          <h1 class="display-title hero__title">Compare markets before committing to a <span class="accent">branch plan</span>.</h1>
          <p class="subhead">The biggest deposit market is rarely the best place to grow. Test each one before the board commits.</p>
        </div>
        <figure class="model model--flip" aria-labelledby="branch-model-title">
          <p class="kicker">A worked example on real data</p>
          <p class="model__title" id="branch-model-title">Where should a Dallas bank grow over the next five years?</p>
          <div class="model__answers">
            <div class="model__answer">
              <span class="model__answer-label">The deposit map says</span>
              <span class="model__answer-county">{mapPick} County</span>
              <span class="model__answer-why">${heroMarkets[mapPick].deposits.toFixed(1)}B in deposits, the biggest market</span>
            </div>
            <div class="model__answer model__answer--case">
              <span class="model__answer-label">The branch economics say</span>
              <span class="model__answer-county">{casePick} County</span>
              <span class="model__answer-why">{Math.round(heroMarkets[casePick].communityShare)}% of deposits at community banks</span>
            </div>
          </div>
          <p class="model__evidence-title">Deposits in a typical community-bank branch</p>
          <dl class="model__bars">
            {branchBars.map((m) => (
              <div class:list={['model__bar', { 'model__bar--case': m.county === casePick }]}>
                <dt>{m.county}</dt>
                <dd class="model__bar-track" aria-hidden="true"><span style={`width: ${Math.round((m.medianCommunityBranch / maxBranch) * 100)}%`}></span></dd>
                <dd class="model__bar-value">${m.medianCommunityBranch}M</dd>
              </div>
            ))}
          </dl>
          <figcaption class="model__note">FDIC Summary of Deposits, June 2026. <a class="link" href="#worked-example">See how the answer flips</a>.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <hr class="section-divider">
  <SignalGrid
    heading="A branch recommendation is only as defensible as its assumptions."
    intro="A clean map can hide a weak case. The analysis keeps public market facts, customer evidence, institution-specific economics, and regulatory and fair-access considerations separate long enough to test each one."
    signals={[
      { title: 'Public market data', copy: 'Branch deposits, market share, household and business growth, competitor presence, and concentration establish the market context.' },
      { title: 'Customer geography', copy: 'Existing households, businesses, digital acquisition, service patterns, and access gaps show whether the institution already has a reason to be there.' },
      { title: 'Institution economics', copy: 'Target balances, ramp assumptions, staffing, cannibalization, and operating constraints turn market attractiveness into a branch decision.' },
    ]}
  />

  <MarketExample />

  <section class="compliance-section">
    <div class="container">
      <h2 class="section-title-plain">CRA, fair banking, and fair lending belong in the market case.</h2>
      <p class="section-intro">The work identifies where branch geography, assessment areas, community credit needs, products, marketing, service levels, and access require institution compliance and legal review.</p>
      <p class="section-intro"><a class="link link--strong section-link" href="/branch-market-expansion-analysis/sample-plan#cra">See the CRA and fair-access section of the sample plan</a></p>
    </div>
  </section>

  <Deliverables
    heading="An expansion plan with the assumptions attached."
    items={[
      { title: 'Market and assessment-area definition', copy: 'A documented view of the counties, ZIP codes, trade areas, time periods, current CRA assessment areas, and other relevant service geographies.' },
      { title: 'Weighted scorecard', copy: 'A ranking model with visible weights, thresholds, source fields, sensitivity tests, and CRA and fair-access flags that should affect diligence.' },
      { title: 'Competitive and access view', copy: 'Deposit share, branch density, competitor movement, customer proximity, service access, and market whitespace displayed in the same frame.' },
      { title: 'Five-year expansion plan', copy: 'The sequence of markets and sites, the ramp each branch is measured against, what the network carries while they ramp, and the cost of CRA commitments named up front.' },
    ]}
  />

  <Offer
    title="Branch and Market Expansion Analysis"
    copy="The scope follows the number of markets, the branch question, and the customer data available. The finished model stays with the institution and can be reused when the market list changes."
    producesCopy="You receive a five-year expansion plan for the board and the analysis behind it."
    inputsTitle="Typical inputs"
    inputs={[
      'The current market list and branch thesis',
      'FDIC or NCUA institution and market data',
      'Census household, income, and business context',
      'Customer geography and existing network performance',
      'The latest CRA performance evaluation and current assessment areas',
      'Fair-lending monitoring, branch policy, and known access concerns',
      'Branch economics and leadership assumptions',
    ]}
  />

  <OtherDecisions current="/branch-market-expansion-analysis" />
  <ServiceClosingBand
    title="Bring the market list and the current branch case."
    copy="We will identify which facts support the recommendation, which assumptions need testing, and which questions belong with compliance or counsel."
    prepText="The markets under consideration and the latest CRA performance evaluation are enough to start."
  />

  <section class="sources" aria-labelledby="sources-heading">
    <div class="container"><h2 class="kicker sources__label" id="sources-heading">Primary public-data and regulatory sources</h2><ol class="sources__list"><li><a href="https://banks.data.fdic.gov/bankfind-suite/SOD">FDIC Summary of Deposits</a> for branch deposits, market share, and branch-office data.</li><li><a href="https://ncua.gov/analysis/credit-union-corporate-call-report-data">NCUA Call Report data</a> for federally insured credit-union financial and institutional information.</li><li><a href="https://www.census.gov/programs-surveys/acs/data/data-via-api.html">U.S. Census Bureau American Community Survey</a> for demographic, household, housing, and economic context.</li><li><a href="https://www.ffiec.gov/data/cra/interagency-qa">FFIEC CRA resources</a> for current interagency CRA guidance and assessment-area considerations.</li><li><a href="https://www.consumerfinance.gov/compliance/compliance-resources/other-applicable-requirements/equal-credit-opportunity-act/">CFPB Equal Credit Opportunity Act resources</a> for fair-lending requirements under ECOA and Regulation B.</li><li><a href="https://www.fdic.gov/consumer-compliance-examination-manual/iv-3-fdic-fair-lending-scope-and-conclusions-memorandum">FDIC fair-lending examination resources</a> for geographic, branch-service, product, and market-area risk considerations.</li><li><a href="https://www.fdic.gov/bank-examinations/establishing-relocating-or-closing-office">FDIC branch-office resources</a> for establishment, relocation, and closing requirements.</li></ol><p class="sources__note">This work supports business decision-making and institution review. It does not replace legal advice, a fair-lending analysis, or a CRA compliance determination.</p></div>
  </section>
</main>
</Base>
