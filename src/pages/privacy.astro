---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PrivacySection from '../components/PrivacySection.astro';

// When information is collected: each situation, and whether you give it, the site collects it, or both.
const moments = [
  { label: 'You read any page on this site', give: false, auto: true },
  { label: 'You accept analytics cookies', give: false, auto: true },
  { label: 'You book a call', give: true, auto: false },
  { label: 'You email me', give: true, auto: false },
];
const how = (m) => [m.give && 'you give it', m.auto && 'collected automatically'].filter(Boolean).join(' and ');

// The full notice, in order. The contents list and section headings are built from this.
const sections = [
  { id: 'role', icon: 'user-round', title: 'Who is responsible' },
  { id: 'ledger', icon: 'sliders-horizontal', title: 'Everything in one table' },
  { id: 'when', icon: 'eye', title: 'When I collect information' },
  { id: 'types', icon: 'database', title: 'What I collect' },
  { id: 'why', icon: 'target', title: 'How and why I use it' },
  { id: 'rights', icon: 'hand', title: 'Your choices and rights' },
  { id: 'security', icon: 'lock', title: 'How I keep it secure' },
  { id: 'where', icon: 'globe', title: 'Where it is stored' },
  { id: 'retention', icon: 'clock', title: 'How long I keep it' },
  { id: 'processors', icon: 'users', title: 'Services that process it' },
  { id: 'cookies', icon: 'cookie', title: 'Cookies' },
  { id: 'changes', icon: 'mail', title: 'Questions and changes' },
];
// The commitments ledger: every kind of information in one row, for readers doing a vendor review.
const ledger = [
  { what: 'Anonymous visit counts: pages viewed, referring site, device and browser', why: 'See which pages are read', basis: 'Legitimate interest', kept: 'Up to 7 years', who: 'PostHog' },
  { what: 'Analytics cookies, approximate location (city and country), heatmaps, and session recordings', why: 'Understand how pages are used and fix what gets in the way', basis: 'Your consent', kept: 'Recordings 30 days; events up to 7 years', who: 'PostHog' },
  { what: 'Booking details: name, email, time, notes', why: 'Arrange and hold the call you asked for', basis: 'Steps you asked me to take', kept: 'While we are in touch, then as ordinary business records', who: 'Cal.com' },
  { what: 'Emails you send me', why: 'Reply and continue the conversation', basis: 'Legitimate interest', kept: 'While we are in touch, then as ordinary business records', who: 'Apple iCloud Mail' },
  { what: 'Technical request data such as IP address', why: 'Deliver the site and protect it from abuse', basis: 'Legitimate interest', kept: "Under Cloudflare's own retention", who: 'Cloudflare' },
  { what: 'Your cookie choice', why: 'Remember what you decided', basis: 'Strictly necessary', kept: '6 months', who: 'Your browser' },
];
const section = Object.fromEntries(sections.map((s) => [s.id, s]));
---
<Base
  title="Privacy Notice | Paul Drago"
  description="How pauldrago.com uses analytics, cookies, and the information you send, at a glance and in full."
  path="/privacy"
  footerNote="Financial services marketing, market analysis, and executive leadership."
  stylesheets={['/assets/privacy.css']}
  lastUpdated="2026-09-23"
>
<main id="main" class="privacy">
  <div class="container">
    <header class="privacy__header">
      <h1 class="display-title privacy__title">Privacy notice.</h1>
      <p class="privacy__intro">How this site handles your information, first at a glance and then in full.</p>
      <p class="privacy__updated">Last updated <time datetime="2026-09-23">September 23, 2026</time></p>
    </header>

    <section class="glance" aria-labelledby="glance-heading">
      <h2 class="glance__heading" id="glance-heading">Your privacy at a glance</h2>
      <p class="glance__intro">Hello. I'm Paul Drago, and this site is run by Glass Vase, LLC, my advisory company. Here's a short summary of how I handle your information and respect your privacy.</p>
      <div class="glance__columns">
        <div class="glance__column">
          <div class="glance__item glance__item--types">
            <div class="glance__item-head">
              <h3><Icon name="database" class="privacy__icon glance__icon" />What I collect</h3>
              <a class="kicker" href="#types">What exactly?</a>
            </div>
            <ul>
              <li>How pages on this site are used</li>
              <li>Details you enter when booking a call</li>
              <li>Emails you send me</li>
            </ul>
          </div>
          <div class="glance__item glance__item--why">
            <div class="glance__item-head">
              <h3><Icon name="target" class="privacy__icon glance__icon" />How I use it</h3>
              <a class="kicker" href="#why">How exactly?</a>
            </div>
            <ul>
              <li>To see which writing is useful and improve the site</li>
              <li>To arrange and hold meetings you book</li>
              <li>To reply to you</li>
            </ul>
          </div>
          <div class="glance__item glance__item--processors">
            <div class="glance__item-head">
              <h3><Icon name="users" class="privacy__icon glance__icon" />Who processes it</h3>
              <a class="kicker" href="#processors">What do they do?</a>
            </div>
            <p>These services process information on my behalf:</p>
            <ul>
              <li>Analytics: PostHog</li>
              <li>Scheduling: Cal.com</li>
              <li>Hosting: Cloudflare</li>
              <li>Email: Apple iCloud Mail</li>
            </ul>
          </div>
          <div class="glance__item glance__item--cookies">
            <div class="glance__item-head">
              <h3><Icon name="cookie" class="privacy__icon glance__icon" />Cookies</h3>
              <a class="kicker" href="#cookies">How can I choose?</a>
            </div>
            <ul>
              <li>Visits are counted without cookies by default</li>
              <li>Analytics cookies are used only if you accept them</li>
              <li>Your browser's Global Privacy Control signal is honored</li>
              <li>No advertising cookies, ever</li>
            </ul>
            <button type="button" class="glance__settings" data-cc="show-preferencesModal">Change your cookie settings</button>
          </div>
        </div>

        <div class="glance__column">
          <div class="glance__item glance__item--when">
            <div class="glance__item-head">
              <h3><Icon name="eye" class="privacy__icon glance__icon" />When I collect it</h3>
              <a class="kicker" href="#when">Am I included?</a>
            </div>
            <p>There are only four moments when information reaches me:</p>
            <div class="timeline">
              <div class="timeline__head" aria-hidden="true">
                <span class="label timeline__key timeline__key--give"><Icon name="user-round" class="privacy__icon timeline__icon" />Data you give</span>
                <span class="label timeline__key timeline__key--auto"><Icon name="monitor" class="privacy__icon timeline__icon" />Data collected</span>
              </div>
              <ul class="timeline__rows">
                {moments.map((m) => (
                  <li class="timeline__row">
                    <span class:list={['timeline__track', 'timeline__track--give', { 'timeline__track--on': m.give }]} aria-hidden="true"></span>
                    <span class:list={['timeline__track', 'timeline__track--auto', { 'timeline__track--on': m.auto }]} aria-hidden="true"></span>
                    <span class="timeline__label">{m.label}<span class="sr-only">: {how(m)}</span></span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="glance__item glance__item--rights">
            <div class="glance__item-head">
              <h3><Icon name="hand" class="privacy__icon glance__icon" />Know your rights</h3>
              <a class="kicker" href="#rights">What can I do?</a>
            </div>
            <ul>
              <li>Change your cookie choice at any time</li>
              <li>Ask what I hold about you</li>
              <li>Have it corrected or deleted</li>
              <li>Take a copy of it with you</li>
              <li>Complain about how I handle it</li>
            </ul>
          </div>
          <p class="glance__contact">Any concerns about your privacy? Email <a href="mailto:paul@pauldrago.com">paul@pauldrago.com</a>.</p>
        </div>
      </div>
      <a class="btn glance__cta" href="#role">Read the full notice <span>(no legalese, promise)</span></a>
    </section>

    <div class="privacy__columns">
      <nav class="privacy__toc" aria-label="Privacy notice contents">
        <p class="kicker">In full</p>
        <ol>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ol>
      </nav>

      <div class="privacy__full">
        <PrivacySection {...section.role}>
          <p class="privacy__summary">Glass Vase, LLC, the company through which I provide advisory services, is responsible for the information this site collects and is the data controller for it (the party that decides how it is used) where data protection law applies. You can reach me at <a class="link" href="mailto:paul@pauldrago.com">paul@pauldrago.com</a>.</p>
          <Fragment slot="detail">
            <p>This notice covers pauldrago.com and the booking and email links on it. It applies to anyone who visits the site, books a call, or writes to me. If we go on to work together, our engagement terms may say more about how client information is handled.</p>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.ledger}>
          <p class="privacy__summary">For anyone doing a vendor or compliance review: every kind of information, why I have it, the legal basis, how long I keep it, and who processes it.</p>
          <div class="ledger">
            <table class="ledger__table" aria-labelledby="ledger-heading">
              <thead>
                <tr><th class="label" scope="col">Information</th><th class="label" scope="col">Why</th><th class="label" scope="col">Legal basis</th><th class="label" scope="col">Kept for</th><th class="label" scope="col">Processed by</th></tr>
              </thead>
              <tbody>
                {ledger.map((row) => (
                  <tr>
                    <th scope="row">{row.what}</th>
                    <td data-label="Why">{row.why}</td>
                    <td data-label="Legal basis">{row.basis}</td>
                    <td data-label="Kept for">{row.kept}</td>
                    <td data-label="Processed by">{row.who}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </PrivacySection>

        <PrivacySection {...section.when}>
          <p class="privacy__summary">Some information you give me directly. The rest is collected automatically as you use the site.</p>
          <Fragment slot="detail">
            <ul>
              {moments.map((m) => <li><strong>{m.label}:</strong> {how(m)}.</li>)}
            </ul>
            <p>If you only read the site and decline analytics cookies, all I get is an anonymous visit count.</p>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.types}>
          <p class="privacy__summary">How you use the site, plus whatever you choose to send me when you book a call or write.</p>
          <Fragment slot="detail">
            <ul>
              <li><strong>Site usage:</strong> pages viewed, links and buttons clicked, how far a page is scrolled, the site that referred you, and your device and browser.</li>
              <li><strong>With analytics cookies accepted:</strong> an identifier that recognizes a return visit, your approximate location (city and country), heatmaps of where people click, and session recordings of how pages are used. Text typed into form fields is masked in recordings.</li>
              <li><strong>IP addresses:</strong> PostHog uses your IP address only to work out that approximate location, then discards it. No IP address is stored with analytics data.</li>
              <li><strong>Bookings:</strong> your name, email address, the time you choose, and any notes you add.</li>
              <li><strong>Email:</strong> your address and whatever your message contains.</li>
            </ul>
            <p>The site doesn't ask for, and I don't want, sensitive information such as account numbers or customer data from your institution.</p>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.why}>
          <p class="privacy__summary">To improve the site, to hold the meetings you book, and to reply to you. Never for advertising, and never sold.</p>
          <Fragment slot="detail">
            <ul>
              <li><strong>Measuring and improving the site.</strong> Cookie-free visit counts rely on my legitimate interest in knowing which pages are read (a lawful basis that doesn't need your consent because the data is anonymous and expected). Analytics cookies, heatmaps, and recordings rely on your consent, which you can withdraw at any time.</li>
              <li><strong>Arranging meetings.</strong> I use booking details to schedule and hold the call you asked for.</li>
              <li><strong>Correspondence.</strong> I use your emails to reply and to continue the conversation you started.</li>
              <li><strong>Keeping the site running and secure.</strong> Cloudflare uses technical request data to deliver the site and protect it from abuse.</li>
            </ul>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.rights}>
          <p class="privacy__summary">You can change your cookie choices at any time, and you can ask me what information I hold about you, correct it, or have it deleted.</p>
          <Fragment slot="detail">
            <ul>
              <li><strong>Cookies:</strong> use <button type="button" class="pd-text-btn pd-text-btn--inline" data-cc="show-preferencesModal">Cookie settings</button> (also in the footer of every page), turn on Global Privacy Control in your browser, or block cookies in your browser.</li>
              <li><strong>Access, correction, and deletion:</strong> email <a class="link" href="mailto:paul@pauldrago.com">paul@pauldrago.com</a> and I will respond within 30 days.</li>
              <li><strong>Objection and portability:</strong> depending on where you live, you may also object to processing or ask for a copy of your data in a portable format.</li>
              <li><strong>Complaints:</strong> if you are in the UK or EU and are unhappy with how I handle your data, you can complain to your local data protection authority.</li>
            </ul>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.security}>
          <p class="privacy__summary">Everything travels over encrypted connections, and the site collects as little as it can.</p>
          <Fragment slot="detail">
            <p>The site is served only over HTTPS. Analytics requests go through pauldrago.com rather than directly to a third party, IP addresses are discarded before analytics data is stored, and cookies are not set until you allow them. No system is perfectly secure. PostHog, Cal.com, Cloudflare, and Apple each run their own security programs.</p>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.where}>
          <p class="privacy__summary">Mainly in the United States.</p>
          <Fragment slot="detail">
            <p>PostHog stores analytics data in the United States and Cal.com processes booking data in the United States. Apple handles email. Cloudflare serves the site from data centers around the world. If you visit from the UK or EU, your information is transferred to the United States under the safeguards those providers offer, such as standard contractual clauses (EU-approved contract terms for protecting data abroad).</p>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.retention}>
          <p class="privacy__summary">Session recordings for 30 days, analytics events for up to seven years, your cookie choice for six months, and bookings and emails for as long as we're in touch.</p>
          <Fragment slot="detail">
            <ul>
              <li><strong>Analytics:</strong> events are kept for up to seven years, the retention limit of this site's PostHog plan. They are stored without IP addresses and are never linked to your name or email. Session recordings are deleted automatically after 30 days.</li>
              <li><strong>Your cookie choice:</strong> remembered for six months, then you are asked again.</li>
              <li><strong>Bookings and email:</strong> kept while we're in touch and for as long as ordinary business records require, then deleted.</li>
            </ul>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.processors}>
          <p class="privacy__summary">Three services help run the site, and Apple handles my email. None of them receives your information to sell it or advertise to you.</p>
          <Fragment slot="detail">
            <ul>
              <li><strong><a class="link" href="https://posthog.com/privacy" target="_blank" rel="noopener noreferrer">PostHog</a></strong> measures how the site is used.</li>
              <li><strong><a class="link" href="https://cal.com/privacy" target="_blank" rel="noopener noreferrer">Cal.com</a></strong> runs the booking scheduler and shares your booking with me. It may set its own cookies once you open the scheduler.</li>
              <li><strong><a class="link" href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">Cloudflare</a></strong> hosts the site and processes technical request data, such as IP addresses, to deliver and protect it.</li>
              <li><strong><a class="link" href="https://www.apple.com/legal/privacy/" target="_blank" rel="noopener noreferrer">Apple iCloud Mail</a></strong> receives and stores email sent to paul@pauldrago.com.</li>
            </ul>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.cookies}>
          <p class="privacy__summary">By default, visits are counted without cookies. Analytics cookies are used only if you accept them. <button type="button" class="pd-text-btn pd-text-btn--inline" data-cc="show-preferencesModal">Change your cookie settings</button></p>
          <Fragment slot="detail">
            <p>Without your consent, PostHog sets no cookies and stores nothing in your browser beyond a record of your choice. Visits are counted with an anonymous identifier calculated on PostHog's servers that changes daily and cannot recognize you over time.</p>
            <ul>
              <li><code>cc_cookie</code> and <code>__ph_opt_in_out_*</code> (strictly necessary): remember your cookie choice.</li>
              <li><code>ph_*</code> (analytics, only if you accept): PostHog's visitor and session identifiers.</li>
            </ul>
            <p><strong>Browser privacy signals.</strong> If your browser sends a <a class="link" href="https://globalprivacycontrol.org" target="_blank" rel="noopener noreferrer">Global Privacy Control</a> signal, it is treated as declining analytics cookies and you are not asked. Browsers' older "Do Not Track" setting has no agreed standard, so the site relies on your cookie choice instead. The site does not allow third parties to track you across other websites.</p>
          </Fragment>
        </PrivacySection>

        <PrivacySection {...section.changes}>
          <p class="privacy__summary">Email <a class="link" href="mailto:paul@pauldrago.com">paul@pauldrago.com</a> with any question. If this notice changes, the date at the top will change with it.</p>
        </PrivacySection>

        <p class="privacy__credit">This privacy notice is based on an open-sourced design from <a href="https://juro.com" target="_blank" rel="noopener">Juro</a> and <a href="https://stefaniapassera.com" target="_blank" rel="noopener">Stefania Passera</a> - get your own <a href="https://info.juro.com/privacy-policy-template" target="_blank" rel="noopener">free privacy policy template</a>.</p>
      </div>
    </div>
  </div>
</main>
</Base>
