---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
// Lucide icons (ISC license), inlined so the homepage needs no icon script.
const icons = {
  'landmark': '<line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/>',
  'chart-no-axes-combined': '<path d="M12 16v5"/><path d="M16 14v7"/><path d="M20 10v11"/><path d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15"/><path d="M4 18v3"/><path d="M8 14v7"/>',
  'notebook-pen': '<path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/>',
  'calendar': '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  'mail': '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  'linkedin': '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
};
const latest = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date - a.data.date)[0];
const meta = {
  "title": "Paul Drago | Financial Services Advisor",
  "description": "Paul Drago advises banks and credit unions on marketing measurement, market decisions, and the operating work behind growth.",
  "path": "/",
  "variant": "home",
  "subline": "Advisor and operator",
  "footerNote": "Financial services marketing, market analysis, and executive leadership.",
  "ogType": "profile",
  "ogImage": "https://pauldrago.com/assets/evidence-table-social.jpg",
  "ogImageAlt": "Financial reporting table and market analysis materials",
  "robots": "",
  "stylesheets": [
    "/assets/personal-site.css"
  ],
  "scripts": [],
  "lastUpdated": "2026-09-23"
};
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://pauldrago.com/#paul-drago",
      "name": "Paul Drago",
      "url": "https://pauldrago.com/",
      "email": "mailto:paul@pauldrago.com",
      "sameAs": ["https://www.linkedin.com/in/pauldrago"],
      "jobTitle": "Financial Services Marketing and Market Analysis Advisor",
      "knowsAbout": ["Bank marketing measurement", "Branch and market expansion analysis", "Bank acquisition footprint analysis", "Fractional CMO leadership"]
    },
    {
      "@type": "WebSite",
      "@id": "https://pauldrago.com/#website",
      "url": "https://pauldrago.com/",
      "name": "Paul Drago",
      "publisher": {"@id": "https://pauldrago.com/#paul-drago"}
    },
    {
      "@type": "ProfilePage",
      "@id": "https://pauldrago.com/#webpage",
      "url": "https://pauldrago.com/",
      "name": "Paul Drago",
      "description": "Paul Drago advises banks and credit unions on marketing measurement, market decisions, and the operating work behind growth.",
      "dateModified": "2026-09-23",
      "isPartOf": {"@id": "https://pauldrago.com/#website"},
      "mainEntity": {"@id": "https://pauldrago.com/#paul-drago"}
    }
  ]
};
---
<Base {...meta} jsonld={jsonld}>
<main id="main">
  <section class="home-hero">
    <div class="container">
      <h1 class="display-title home-title">I'm Paul Drago.</h1>
      <p class="home-intro">I advise banks and credit unions on marketing measurement, market decisions, and the operating work behind growth.</p>
      {latest && <p class="home-latest">If you'd like to see how I think about financial services, read the most recent article I wrote: <a href={`/articles/${latest.id}`}>{latest.data.title}</a>.</p>}

      <nav class="link-groups" aria-label="Selected links">
        <section class="link-group" aria-labelledby="work-links">
          <h2 class="link-group-title" id="work-links">Work</h2>
          <a class="plain-link" href="/financial-services">
            <svg class="plain-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons['landmark']} />
            <span><span class="plain-link-title">Services</span><span class="plain-link-description">Marketing measurement, market analysis, acquisition footprints, and fractional leadership.</span></span>
          </a>
          <a class="plain-link" href="/marketing-measurement-reset">
            <svg class="plain-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons['chart-no-axes-combined']} />
            <span><span class="plain-link-title">Measurement reset</span><span class="plain-link-description">Connect acquisition spend to retained accounts, funded balances, and board reporting.</span></span>
          </a>
        </section>

        <section class="link-group" aria-labelledby="writing-links">
          <h2 class="link-group-title" id="writing-links">Writing</h2>
          <a class="plain-link" href="/articles">
            <svg class="plain-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons['notebook-pen']} />
            <span><span class="plain-link-title">Articles</span><span class="plain-link-description">Essays and working notes.</span></span>
          </a>
        </section>

        <section class="link-group" aria-labelledby="contact-links">
          <h2 class="link-group-title" id="contact-links">Contact</h2>
          <a class="plain-link" href="https://cal.com/pauldrago/20-min-intro-call" data-cal-link="pauldrago/20-min-intro-call" data-cal-namespace="20-min-intro-call" data-cal-config='&#123;"layout":"month_view","useSlotsViewOnSmallScreen":"true","theme":"auto"&#125;'>
            <svg class="plain-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons['calendar']} />
            <span><span class="plain-link-title">Book a call</span></span>
          </a>
          <a class="plain-link" href="mailto:paul@pauldrago.com">
            <svg class="plain-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons['mail']} />
            <span><span class="plain-link-title">Email</span></span>
          </a>
          <a class="plain-link" href="https://www.linkedin.com/in/pauldrago" target="_blank" rel="noopener noreferrer">
            <svg class="plain-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons['linkedin']} />
            <span><span class="plain-link-title">LinkedIn</span></span>
          </a>
        </section>
      </nav>
    </div>
  </section>
</main>
</Base>
