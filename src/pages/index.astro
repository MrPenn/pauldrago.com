---
import Base from '../layouts/Base.astro';
import BookCallLink from '../components/BookCallLink.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../data/icons';
import { getCollection } from 'astro:content';
const latest = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
// The links under the introduction, in three groups. The booking link has no href; BookCallLink
// supplies the scheduler's address.
const linkGroups: { id: string; title: string; links: { href?: string; icon: IconName; title: string; description?: string }[] }[] = [
  { id: 'work-links', title: 'Work', links: [
    { href: '/financial-services', icon: 'landmark', title: 'Services', description: 'Marketing measurement and operations, market analysis, acquisition footprints, and fractional leadership.' },
    { href: '/marketing-measurement-reset', icon: 'chart-no-axes-combined', title: 'Measurement reset', description: 'Connect acquisition spend to retained accounts, funded balances, and board reporting.' },
  ] },
  { id: 'writing-links', title: 'Writing', links: [
    { href: '/articles', icon: 'notebook-pen', title: 'Articles', description: 'Essays and working notes.' },
  ] },
  { id: 'contact-links', title: 'Contact', links: [
    { icon: 'calendar', title: 'Book a call' },
    { href: 'mailto:paul@pauldrago.com', icon: 'mail', title: 'Email' },
    { href: 'https://www.linkedin.com/in/pauldrago', icon: 'linkedin', title: 'LinkedIn' },
  ] },
];
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": "https://pauldrago.com/#webpage",
      "url": "https://pauldrago.com/",
      "name": "Paul Drago",
      "description": "Paul Drago advises banks and credit unions on marketing measurement, marketing operations, and market decisions.",
      "isPartOf": {
        "@id": "https://pauldrago.com/#website"
      },
      "mainEntity": {
        "@id": "https://pauldrago.com/#paul-drago"
      }
    }
  ]
};
---
<Base
  title="Paul Drago | Financial Services Advisor"
  description="Paul Drago advises banks and credit unions on marketing measurement, marketing operations, and market decisions."
  path="/"
  home
  footerNote="Financial services marketing, market analysis, and executive leadership."
  ogType="profile"
  ogImage="https://pauldrago.com/assets/evidence-table-social.jpg"
  ogImageAlt="Financial reporting table and market analysis materials"
  stylesheets={['/assets/personal-site.css']}
  jsonld={jsonld}
>
<main id="main">
  <section class="home">
    <div class="container">
      <h1 class="display-title home__title">I'm Paul Drago.</h1>
      <p class="home__intro">I advise banks and credit unions on marketing measurement, marketing operations, and market decisions.</p>
      {latest && <p class="home__latest">If you'd like to see how I think about financial services, read the most recent article I wrote: <a class="link" href={`/articles/${latest.id}`}>{latest.data.title}</a>.</p>}

      <nav class="link-groups" aria-label="Selected links">
        {linkGroups.map((group) => (
          <section class="link-group" aria-labelledby={group.id}>
            <h2 class="kicker link-group__title" id={group.id}>{group.title}</h2>
            {group.links.map((link) => {
              const Link = link.href ? 'a' : BookCallLink;
              const external = link.href?.startsWith('https:');
              return (
                <Link class="plain-link" href={link.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                  <Icon name={link.icon} class="plain-link__icon" />
                  <span><span class="plain-link__title">{link.title}</span>{link.description && <span class="plain-link__description">{link.description}</span>}</span>
                </Link>
              );
            })}
          </section>
        ))}
      </nav>
    </div>
  </section>
</main>
</Base>
