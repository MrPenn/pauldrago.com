---
const SITE = 'https://pauldrago.com';
const BOOKING = 'https://cal.com/pauldrago/20-min-intro-call';
const CAL_ATTRS = {
  'data-cal-link': 'pauldrago/20-min-intro-call',
  'data-cal-namespace': '20-min-intro-call',
  'data-cal-config': '{"layout":"month_view","useSlotsViewOnSmallScreen":"true","theme":"light"}',
};
const {
  title,
  description,
  path = '/',
  variant = 'product',
  subline = '',
  footerNote = 'Financial services marketing, market analysis, and executive leadership.',
  ogType = 'website',
  ogImage = `${SITE}/assets/evidence-table-social.jpg`,
  ogImageAlt = 'Financial reporting table and market analysis materials',
  robots = '',
  stylesheets = [],
  scripts = [],
  lastUpdated = '2026-09-22',
  jsonld = null,
} = Astro.props;
const canonical = SITE + (path === '/' ? '/' : path);
const updatedLabel = new Date(lastUpdated + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonical}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Paul Drago">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:alt" content={ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="Paul Drago, articles" href="/rss.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
<script is:inline>
(function(){try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();
</script>
<link rel="stylesheet" href="/assets/site-shell.css">
{stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="trace-rail" aria-hidden="true"><div class="trace-fill"></div></div>

<header>
  <div class="container">
    <div class="header-inner">
      {variant === 'home' && (
        <>
          <div class="brand-group">
            <div class="brand-name">Paul Drago</div>
            <div class="brand-subline">{subline}</div>
          </div>
          <div class="header-end"><a class="header-link" href="/financial-services">Financial services</a><button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
  <svg class="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button></div>
        </>
      )}
      {variant === 'services' && (
        <>
          <a class="brand-home" href="/" aria-label="Paul Drago home">
            <div class="brand-group">
              <div class="brand-name">Paul Drago</div>
              <div class="brand-subline">{subline}</div>
            </div>
          </a>
          <div class="header-end"><a class="btn" href={BOOKING} {...CAL_ATTRS}>Book a call</a><button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
  <svg class="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button></div>
        </>
      )}
      {variant === 'product' && (
        <>
          <a class="brand-home" href="/financial-services" aria-label="Paul Drago financial services">
            <div class="brand-group">
              <div class="brand-name">Paul Drago</div>
              <div class="brand-subline">{subline}</div>
            </div>
          </a>
          <nav class="header-actions" aria-label="Primary">
            <a class="services-link" href="/financial-services">Financial services</a>
            <a class="btn" href={BOOKING} {...CAL_ATTRS}>Book a call</a>
            <button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
  <svg class="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button>
          </nav>
        </>
      )}
      {variant === 'articles' && (
        <>
          <a class="brand-home" href="/">
            <span class="brand-group">
              <span class="brand-name">Paul Drago</span>
              <span class="brand-subline">{subline}</span>
            </span>
          </a>
          <div class="header-end"><a class="header-link" href="/">Home</a><button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
  <svg class="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button></div>
        </>
      )}
    </div>
  </div>
</header>

<slot />

<footer>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">Paul Drago</div>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/financial-services">Financial services</a>
        <a href="/articles">Articles</a>
        <a href="mailto:paul@pauldrago.com">paul@pauldrago.com</a>
        <a href="https://www.linkedin.com/in/pauldrago" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
    <div class="footer-meta">
      <div>{footerNote}</div>
      <div><time datetime={lastUpdated}>Last updated {updatedLabel}.</time></div>
    </div>
  </div>
</footer>
<script is:inline>
(function(){
  var root=document.documentElement, mq=window.matchMedia('(prefers-color-scheme: dark)');
  function current(){var t=root.getAttribute('data-theme');return t||(mq.matches?'dark':'light');}
  function paint(){
    var dark=current()==='dark';
    document.querySelectorAll('[data-theme-toggle]').forEach(function(b){b.setAttribute('aria-label',dark?'Switch to light theme':'Switch to dark theme');b.setAttribute('data-on',dark?'dark':'light');});
    document.querySelectorAll('source[data-dark]').forEach(function(src){src.media=dark?'all':'not all';});
  }
  document.querySelectorAll('[data-theme-toggle]').forEach(function(b){b.addEventListener('click',function(){
    var next=current()==='dark'?'light':'dark';
    root.setAttribute('data-theme',next);
    try{localStorage.setItem('theme',next);}catch(e){}
    paint();
  });});
  mq.addEventListener&&mq.addEventListener('change',paint);
  paint();
})();
</script>
{scripts.map((src) => <script is:inline src={src}></script>)}
<script is:inline src="/assets/cal-booking.js"></script>
</body>
</html>
