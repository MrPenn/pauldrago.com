---
import { readFileSync } from 'node:fs';
import { join, posix } from 'node:path';
import PostHog from '../components/posthog.astro';
import { SHARED_NODES, PAGE_TYPES, WEBSITE_ID, ORG_ID } from '../data/schema';
import CookieConsent from '../components/CookieConsent.astro';

const SITE = 'https://pauldrago.com';
// Cache-buster: changes every build so browsers and the CDN fetch fresh scripts after a deploy.
const ASSET_V = Date.now().toString(36);
const v = (href) => `${href}?v=${ASSET_V}`;
// One line under the name on every page; the page title already says where you are.
const SUBLINE = 'Advisor to banks and credit unions';
const BOOKING = 'https://cal.com/pauldrago/20-min-intro-call';
const CAL_ATTRS = {
  'data-cal-link': 'pauldrago/20-min-intro-call',
  'data-cal-namespace': '20-min-intro-call',
  'data-cal-config': '{"layout":"month_view","useSlotsViewOnSmallScreen":"true","theme":"auto"}',
};
const {
  title,
  description,
  path = '/',
  variant = 'product',
  subline = '',
  footerNote = 'Financial services marketing, market analysis, and executive leadership.',
  ogType = 'website',
  ogImage = `${SITE}/assets/evidence-table-social.jpg`,
  ogImageAlt = 'Financial reporting table and market analysis materials',
  robots = '',
  stylesheets = [],
  scripts = [],
  lastUpdated = '2026-09-22',
  jsonld = null,
  published = null,
  modified = null,
} = Astro.props;
// Stylesheets are small, so they are inlined to keep them off the critical path.
// Relative url() references are rewritten to absolute paths so they still resolve from any page.
const inlineCss = (href) => readFileSync(join(process.cwd(), 'public', href), 'utf8')
  .replace(/url\((['"]?)(?![a-z]+:|\/)/gi, `url($1${posix.dirname(href)}/`);
const css = ['/assets/site-shell.css', ...stylesheets].map(inlineCss).join('\n');
const canonical = SITE + (path === '/' ? '/' : path);
// Which top-level section a page belongs to, for the header's current-page mark.
const section = path.startsWith('/articles') ? 'articles' : ['/financial-services', '/marketing-measurement-reset', '/branch-market-expansion-analysis', '/acquisition-footprint-analysis', '/fractional-cmo-financial-services'].some((p) => path.startsWith(p)) ? 'services' : '';
// Structured data: the shared person, company, and website entities, plus this page's own nodes.
// Page nodes are linked to the website, dated from lastUpdated, and services credited to the company.
// Pages that define nothing get a basic WebPage node; noindex pages get none.
const sharedIds = new Set(SHARED_NODES.map((n) => n['@id']));
const pageNodes = (jsonld ? (jsonld['@graph'] ?? [jsonld]) : robots.includes('noindex') ? [] : [{
  '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description,
}])
  .filter((n) => !sharedIds.has(n['@id']))
  .map(({ '@context': _context, ...n }) => {
    if (PAGE_TYPES.has(n['@type'])) {
      n.isPartOf = { '@id': WEBSITE_ID };
      n.inLanguage = 'en-US';
      n.dateModified = lastUpdated;
    }
    if (n['@type'] === 'Service') n.provider = { '@id': ORG_ID };
    return n;
  });
const structuredData = pageNodes.length ? { '@context': 'https://schema.org', '@graph': [...SHARED_NODES, ...pageNodes] } : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonical}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Paul Drago">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:alt" content={ogImageAlt}>
{ogType === 'article' && published && <meta property="article:published_time" content={published} />}
{ogType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
{ogType === 'article' && <meta property="article:author" content="https://pauldrago.com/" />}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="Paul Drago, articles" href="/rss.xml">
<link rel="preload" href="/fonts/archivo-black-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
<style is:inline>
@font-face { font-family: 'Archivo Black'; font-style: normal; font-weight: 400; font-display: swap; src: url(/fonts/archivo-black-latin.woff2) format('woff2'); }
@font-face { font-family: 'IBM Plex Sans'; font-style: normal; font-weight: 400 700; font-display: swap; src: url(/fonts/ibm-plex-sans-latin.woff2) format('woff2'); }
@font-face { font-family: 'Source Serif 4'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/fonts/source-serif-4-latin.woff2) format('woff2'); }
@font-face { font-family: 'Source Serif 4'; font-style: italic; font-weight: 400; font-display: swap; src: url(/fonts/source-serif-4-italic-latin.woff2) format('woff2'); }
/* Fallbacks sized to match the web fonts' metrics so the swap does not shift layout. */
@font-face { font-family: 'Archivo Black Fallback'; src: local('Arial Bold'), local('Arial-BoldMT'), local('Liberation Sans Bold'); size-adjust: 113.47%; ascent-override: 77.38%; descent-override: 18.51%; line-gap-override: 0%; }
@font-face { font-family: 'IBM Plex Sans Fallback'; src: local('Arial'), local('ArialMT'), local('Liberation Sans'); size-adjust: 97%; ascent-override: 105.67%; descent-override: 28.35%; line-gap-override: 0%; }
@font-face { font-family: 'Source Serif 4 Fallback'; src: local('Times New Roman'), local('TimesNewRomanPSMT'), local('Liberation Serif'); size-adjust: 103.47%; ascent-override: 100.13%; descent-override: 32.38%; line-gap-override: 0%; }
</style>
<style is:inline set:html={css}></style>
{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
<PostHog />
</head>
<body class:list={[{ 'no-trace-script': scripts.length === 0 }]}>
<Fragment set:html="<!--email_off-->" />
<a class="skip-link" href="#main">Skip to content</a>
<div class="trace-rail" aria-hidden="true"><div class="trace-fill"></div></div>

<header>
  <div class="container">
    <div class="header-inner">
      {variant === 'home' ? (
        <span class="brand-group">
          <span class="brand-name">Paul Drago</span>
          <span class="brand-subline">{SUBLINE}</span>
        </span>
      ) : (
        <a class="brand-home" href="/">
          <span class="brand-group">
            <span class="brand-name">Paul Drago</span>
            <span class="brand-subline">{SUBLINE}</span>
          </span>
        </a>
      )}
      <nav class="header-actions" aria-label="Primary">
        <a class="header-link" href="/financial-services" aria-current={section === 'services' ? 'page' : undefined}>Services</a>
        <a class="header-link" href="/articles" aria-current={section === 'articles' ? 'page' : undefined}>Articles</a>
        <a class="btn" href={BOOKING} {...CAL_ATTRS}>Book a call</a>
      </nav>
    </div>
  </div>
</header>

<slot />

<footer>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">Paul Drago</div>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/financial-services">Services</a>
        <a href="/articles">Articles</a>
        <a href="mailto:paul@pauldrago.com">paul@pauldrago.com</a>
        <a href="https://www.linkedin.com/in/pauldrago" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="/privacy">Privacy</a>
        <button type="button" class="footer-link-button" data-cc="show-preferencesModal">Cookie settings</button>
      </div>
    </div>
    <div class="footer-meta">
      <div>{footerNote}</div>
    </div>
  </div>
</footer>
{scripts.map((src) => <script is:inline defer src={v(src)}></script>)}
<script is:inline defer src={v('/assets/cal-booking.js')}></script>
<CookieConsent />
<Fragment set:html="<!--/email_off-->" />
</body>
</html>
