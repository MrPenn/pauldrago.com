---
import PostHog from '../components/posthog.astro';
import { SHARED_NODES, PAGE_TYPES, WEBSITE_ID, ORG_ID } from '../data/schema';
import CookieConsent from '../components/CookieConsent.astro';
import Fonts from '../components/Fonts.astro';
import BookCallLink from '../components/BookCallLink.astro';
import BrandGroup from '../components/BrandGroup.astro';
import { SERVICES } from '../data/services';
import { inlineSheets } from './inline-css.mjs';

const SITE = 'https://pauldrago.com';
// Cache-buster: changes every build so browsers and the CDN fetch fresh scripts after a deploy.
const ASSET_V = Date.now().toString(36);
const v = (href) => `${href}?v=${ASSET_V}`;
const {
  title,
  description,
  path = '/',
  home = false,
  footerNote = 'Financial services marketing, market analysis, and executive leadership.',
  ogType = 'website',
  ogImage = `${SITE}/assets/evidence-table-social.jpg`,
  ogImageAlt = 'Financial reporting table and market analysis materials',
  robots = '',
  stylesheets = [],
  scripts = [],
  lastUpdated = '2026-09-22',
  jsonld = null,
  published = null,
  modified = null,
} = Astro.props;
// Stylesheets are small, so they are inlined to keep them off the critical path.
const css = inlineSheets(['/assets/site-shell.css', ...stylesheets]);
const canonical = SITE + (path === '/' ? '/' : path);
// Which top-level section a page belongs to, for the header's current-page mark.
const section = path.startsWith('/articles') ? 'articles' : ['/financial-services', ...SERVICES.map((s) => s.href)].some((p) => path.startsWith(p)) ? 'services' : '';
// Structured data: the shared person, company, and website entities, plus this page's own nodes.
// Page nodes are linked to the website, dated from lastUpdated, and services credited to the company.
// Pages that define nothing get a basic WebPage node; noindex pages get none.
const sharedIds = new Set(SHARED_NODES.map((n) => n['@id']));
const pageNodes = (jsonld ? (jsonld['@graph'] ?? [jsonld]) : robots.includes('noindex') ? [] : [{
  '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description,
}])
  .filter((n) => !sharedIds.has(n['@id']))
  .map(({ '@context': _context, ...n }) => {
    if (PAGE_TYPES.has(n['@type'])) {
      n.isPartOf = { '@id': WEBSITE_ID };
      n.inLanguage = 'en-US';
      n.dateModified = lastUpdated;
    }
    if (n['@type'] === 'Service') n.provider = { '@id': ORG_ID };
    return n;
  });
const structuredData = pageNodes.length ? { '@context': 'https://schema.org', '@graph': [...SHARED_NODES, ...pageNodes] } : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonical}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Paul Drago">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
{ogType === 'article' && published && <meta property="article:published_time" content={published} />}
{ogType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
{ogType === 'article' && <meta property="article:author" content="https://pauldrago.com/" />}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="Paul Drago, articles" href="/rss.xml">
<Fonts />
<style is:inline set:html={css}></style>
{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
<PostHog />
</head>
<body>
<Fragment set:html="<!--email_off-->" />
<a class="skip-link" href="#main">Skip to content</a>
<div class="trace-rail" aria-hidden="true"><div class="trace-rail__fill"></div></div>

<header class="site-header" data-c="site-header">
  <div class="container">
    <div class="site-header__inner">
      {home ? <BrandGroup /> : <a class="brand" href="/"><BrandGroup /></a>}
      <nav class="site-header__nav" aria-label="Primary">
        <a class="site-header__link" href="/financial-services" aria-current={section === 'services' ? 'page' : undefined}>Services</a>
        <a class="site-header__link" href="/articles" aria-current={section === 'articles' ? 'page' : undefined}>Articles</a>
        <BookCallLink class="btn">Book a call</BookCallLink>
      </nav>
    </div>
  </div>
</header>

<slot />

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">Paul Drago</div>
      <div class="site-footer__links">
        <a class="site-footer__link" href="/">Home</a>
        <a class="site-footer__link" href="/financial-services">Services</a>
        <a class="site-footer__link" href="/articles">Articles</a>
        <a class="site-footer__link" href="mailto:paul@pauldrago.com">paul@pauldrago.com</a>
        <a class="site-footer__link" href="https://www.linkedin.com/in/pauldrago" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="site-footer__link" href="/privacy">Privacy</a>
        <button type="button" class="site-footer__button" data-cc="show-preferencesModal">Cookie settings</button>
      </div>
    </div>
    <div class="site-footer__meta">
      <div>{footerNote}</div>
    </div>
  </div>
</footer>
<script is:inline defer src={v('/assets/trace-rail.js')}></script>
{scripts.map((src) => <script is:inline defer src={v(src)}></script>)}
<script is:inline defer src={v('/assets/cal-booking.js')}></script>
<CookieConsent />
<Fragment set:html="<!--/email_off-->" />
</body>
</html>
