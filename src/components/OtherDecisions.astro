---
// "Other decisions" row for the product pages: the sibling services, so a reader
// who landed on the wrong one is one click from the right one.
import { SERVICES } from '../data/services';
const { current } = Astro.props;
const services = SERVICES.filter((s) => s.href !== current);
---
<nav class="other-decisions" aria-labelledby="other-decisions-heading">
  <div class="container">
    <h2 class="label label--accent" id="other-decisions-heading">Facing a different decision?</h2>
    <ul class="other-decisions__list">
      {services.map((s) => (
        <li><a class="other-decisions__link" href={s.href}><span class="other-decisions__name">{s.name}</span><span class="other-decisions__question">{s.question}</span></a></li>
      ))}
    </ul>
    <a class="other-decisions__all" href="/financial-services">All services</a>
  </div>
</nav>
