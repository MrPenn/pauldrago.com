---
// The problem band on a service-detail page: a heading, an intro and three signal cards.
interface Props { heading: string; intro: string; signals: { title: string; copy: string }[] }
const { heading, intro, signals } = Astro.props;
---
<section class="problem-band">
  <div class="container">
    <h2 class="section-title-plain">{heading}</h2>
    <p class="section-intro">{intro}</p>
    <div class="signal-grid">
      {signals.map((s) => <div class="signal"><h3 class="display-title signal__title">{s.title}</h3><p class="signal__copy">{s.copy}</p></div>)}
    </div>
  </div>
</section>
