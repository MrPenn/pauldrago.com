---
const apiKey = import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN;
const isDevelopment = import.meta.env.DEV;
// Production always goes through the /ingest Pages Function proxy; `astro dev` has no Functions, so it uses PUBLIC_POSTHOG_HOST.
const apiHost = isDevelopment ? import.meta.env.PUBLIC_POSTHOG_HOST : '/ingest';
---
<script is:inline define:vars={{ apiKey, apiHost, isDevelopment }}>
  // Owner's browsers stay out of analytics: open any page with ?internal=on once to switch
  // PostHog off in that browser for good, and ?internal=off to switch it back on.
  let internalBrowser = false;
  try {
    const internalFlag = new URLSearchParams(location.search).get('internal');
    if (internalFlag === 'on') localStorage.setItem('pd_internal', '1');
    if (internalFlag === 'off') localStorage.removeItem('pd_internal');
    internalBrowser = localStorage.getItem('pd_internal') === '1';
  } catch (error) {}

  if (internalBrowser) {
    // No analytics in this browser.
  } else if (!apiKey || !apiHost) {
    if (isDevelopment) {
      const missingVariable = !apiKey
        ? 'PUBLIC_POSTHOG_PROJECT_TOKEN'
        : 'PUBLIC_POSTHOG_HOST';
      throw new Error(
        `${missingVariable} variable required by PostHog is missing or un-configured, this causes events to be silently missed. This error stops appearing once ${missingVariable} is configured`,
      );
    }
  } else {
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],Object.defineProperty(u,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e}}),Object.defineProperty(u.people,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+".people (stub)"}}),o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    // The stub above queues calls; init (which downloads the SDK) waits for the first interaction
    // or for the browser to go idle a second after load, so analytics stays out of the first render.
    // The snippet only creates its queueing methods inside init, so capture gets a queueing stub now.
    posthog.capture = posthog.capture || function () { posthog.push(['capture'].concat(Array.prototype.slice.call(arguments))); };
    // Consent: until a visitor accepts analytics cookies, PostHog runs cookieless (no cookies or
    // browser storage; visits are counted by a server-side hash). The cookie banner reports the
    // visitor's choice through setAnalyticsConsent; accepting switches to normal cookie tracking.
    let analyticsConsent = null;
    function applyAnalyticsConsent(instance) {
      const ph = instance || (posthog.__loaded ? posthog : null);
      if (analyticsConsent === null || !ph) return;
      const status = ph.get_explicit_consent_status();
      if (analyticsConsent && status !== 'granted') ph.opt_in_capturing();
      if (!analyticsConsent && status !== 'denied') ph.opt_out_capturing();
    }
    window.setAnalyticsConsent = (granted) => {
      analyticsConsent = granted;
      applyAnalyticsConsent();
    };

    // Error tracking: the SDK's exception autocapture only hooks in once it has loaded, so errors
    // thrown earlier (usually page-load errors) are held here and handed over when it loads.
    const earlyErrors = [];
    const holdError = (event) => earlyErrors.push(event.type === 'error' ? event.error || event.message : event.reason);
    window.addEventListener('error', holdError);
    window.addEventListener('unhandledrejection', holdError);
    function flushEarlyErrors(ph) {
      window.removeEventListener('error', holdError);
      window.removeEventListener('unhandledrejection', holdError);
      earlyErrors.splice(0).forEach((error) => ph.captureException(error, { captured_before_load: true }));
    }

    let posthogStarted = false;
    const interactionEvents = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
    function startPostHog() {
      if (posthogStarted) return;
      posthogStarted = true;
      interactionEvents.forEach((type) => window.removeEventListener(type, startPostHog));
      posthog.init(apiKey, {
        api_host: apiHost,
        ui_host: 'https://us.posthog.com',
        cookieless_mode: 'on_reject',
        opt_out_capturing_by_default: true,
        capture_exceptions: {
          capture_unhandled_errors: true,
          capture_unhandled_rejections: true,
          capture_console_errors: false,
        },
        enable_heatmaps: true,
        loaded: (ph) => {
          applyAnalyticsConsent(ph);
          flushEarlyErrors(ph);
        },
      });
    }
    interactionEvents.forEach((type) => window.addEventListener(type, startPostHog, { once: true, passive: true }));
    window.addEventListener('load', () => {
      setTimeout(() => (window.requestIdleCallback || setTimeout)(startPostHog), 1000);
    }, { once: true });

    // Reading depth: one event per milestone per page view, measured against the main content.
    const depthMilestones = [25, 50, 75, 100];
    const reachedDepths = new Set();

    function trackScrollDepth() {
      const content = document.getElementById('main') || document.body;
      const rect = content.getBoundingClientRect();
      const readable = rect.height - window.innerHeight;
      const percent = readable > 0 ? -rect.top / readable * 100 : 100;

      for (const depth of depthMilestones) {
        if (percent >= depth && !reachedDepths.has(depth)) {
          reachedDepths.add(depth);
          posthog.capture('scroll_depth_reached', { depth });
        }
      }
      if (reachedDepths.size === depthMilestones.length) {
        window.removeEventListener('scroll', trackScrollDepth);
      }
    }

    window.addEventListener('scroll', trackScrollDepth, { passive: true });
  }
</script>
